            ctx.fillStyle = th.compText;
            ctx.font = '800 11px monospace';
            ctx.fillText(isRam ? 'RAM 16×4' : 'ROM 16×4', 0, -comp.h / 2 + 11);
            const cw = 15, ch = 12, gx0 = -2 * cw, gy0 = -comp.h / 2 + 22;
            ctx.font = '700 8px monospace';
            for (let i = 0; i < 16; i++) {
              const cx = gx0 + (i % 4) * cw, cy = gy0 + Math.floor(i / 4) * ch;
              const sel = i === addr;
              ctx.fillStyle = sel ? th.sig1 : 'rgba(100,116,139,0.18)';
              roundRectPath(ctx, cx + 1, cy + 1, cw - 2, ch - 2, 3);
              ctx.fill();
              ctx.fillStyle = sel ? th.compFill : th.compText;
              ctx.fillText((mem[i] & 15).toString(16).toUpperCase(), cx + cw / 2, cy + ch / 2 + 0.5);
            }
            ctx.fillStyle = th.subText;
            ctx.font = '700 9px monospace';
            ctx.fillText(`[${addr.toString(16).toUpperCase()}] = ${(mem[addr] & 15).toString(16).toUpperCase()}`, 0, gy0 + 4 * ch + 12);
            break;
          }
          case 'ALU_4': {
            const OPS = ['A+B', 'A−B', 'A&B', 'A|B', 'A^B', '~A', 'A+1', 'A«1'];
            ctx.fillStyle = th.compText;
            ctx.font = '800 12px monospace';
            ctx.fillText('ALU', 0, -comp.h / 2 + 12);
            ctx.fillStyle = th.sig1;
            ctx.font = '800 11px monospace';
            ctx.fillText(OPS[st.aluOp || 0], 0, -comp.h / 2 + 30);
            ctx.fillStyle = th.subText;
            ctx.font = '700 9px monospace';
            ctx.fillText(`A=${(st.aluA || 0).toString(16).toUpperCase()} B=${(st.aluB || 0).toString(16).toUpperCase()}`, 0, -8);
            ctx.save();
            ctx.shadowColor = th.sig1; ctx.shadowBlur = 10;
            ctx.fillStyle = th.sig1;
            ctx.font = '800 24px monospace';
            ctx.fillText((st.aluRes || 0).toString(16).toUpperCase(), 0, 20);
            ctx.restore();
            break;
          }
          case 'FSM': {
            const f = st.fsm || { n: 1, next0: [0], next1: [0], out: [0] };
            const cur = (st.fsmState || 0) % f.n;
            const R = 38, r = 10;
            const pos = i => ({ x: Math.cos(-Math.PI / 2 + i * 2 * Math.PI / f.n) * R, y: Math.sin(-Math.PI / 2 + i * 2 * Math.PI / f.n) * R + 2 });
            const arrow = (i, j, color, off) => {
              const a = pos(i), b = pos(j);
              if (i === j) {
                const ang = Math.atan2(a.y - 2, a.x);
                const ox = a.x + Math.cos(ang) * (r + 4), oy = a.y + Math.sin(ang) * (r + 4);
                ctx.beginPath();
                ctx.arc(ox + off * Math.sin(ang), oy - off * Math.cos(ang), 4.5, 0, Math.PI * 2);
                ctx.strokeStyle = color; ctx.lineWidth = 1.1; ctx.stroke();
                return;
              }
              const dx = b.x - a.x, dy = b.y - a.y, d = Math.hypot(dx, dy), ux = dx / d, uy = dy / d, nx = -uy, ny = ux;
              const sx = a.x + ux * r + nx * off, sy = a.y + uy * r + ny * off;
              const ex = b.x - ux * (r + 1) + nx * off, ey = b.y - uy * (r + 1) + ny * off;
              ctx.beginPath(); ctx.moveTo(sx, sy); ctx.lineTo(ex, ey);
              ctx.strokeStyle = color; ctx.lineWidth = 1.1; ctx.stroke();
              ctx.beginPath(); ctx.moveTo(ex, ey);
              ctx.lineTo(ex - ux * 5 + nx * 2.8, ey - uy * 5 + ny * 2.8);
              ctx.lineTo(ex - ux * 5 - nx * 2.8, ey - uy * 5 - ny * 2.8);
              ctx.closePath(); ctx.fillStyle = color; ctx.fill();
            };
            for (let i = 0; i < f.n; i++) {
              arrow(i, f.next0[i] % f.n, 'rgba(148,163,184,0.55)', -2.5);
              arrow(i, f.next1[i] % f.n, th.sig1, 2.5);
            }
            for (let i = 0; i < f.n; i++) {
              const p = pos(i), on = i === cur;
              ctx.save();
              if (on) { ctx.shadowColor = th.sig1; ctx.shadowBlur = 12; }
              ctx.beginPath(); ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
              ctx.fillStyle = on ? th.sig1 : th.compFill;
              ctx.fill();
              ctx.strokeStyle = f.out[i] ? th.warn : th.compStroke;
              ctx.lineWidth = f.out[i] ? 2.4 : 1.4;
              ctx.stroke();
              ctx.restore();
              ctx.fillStyle = on ? th.compFill : th.compText;
              ctx.font = '800 9px monospace';
              ctx.fillText(`S${i}`, p.x, p.y + 0.5);
            }
            ctx.fillStyle = th.subText;
            ctx.font = '700 9px monospace';
            ctx.fillText(`S${cur} · Z=${f.out[cur] ? 1 : 0}`, 0, comp.h / 2 - 9);
            break;
          }
          case 'LED_MATRIX_4X4': {
            const col = (LED_PALETTE[comp.color] || LED_PALETTE.cyan).hex;
            ctx.fillStyle = 'rgba(0,0,0,0.32)';
            roundRectPath(ctx, -50, -50, 100, 100, 8);
            ctx.fill();
            for (let r = 0; r < 4; r++) {
              for (let c = 0; c < 4; c++) {
                const on = bit(pv['row' + r]) === 1 && bit(pv['col' + c]) === 1;
                const cx = -34.5 + c * 23, cy = -34.5 + r * 23;
                ctx.save();
                if (on) { ctx.shadowColor = col; ctx.shadowBlur = 10; }
                ctx.beginPath(); ctx.arc(cx, cy, 8, 0, Math.PI * 2);
                ctx.fillStyle = on ? col : 'rgba(100,116,139,0.2)';
                ctx.fill();
                ctx.restore();
              }
            }
            break;
          }
          case 'AND': case 'NAND': case 'OR': case 'NOR': case 'XOR': case 'XNOR':
          case 'NOT': case 'BUFFER': case 'TRI_BUFFER': case 'MUX_2': case 'MUX_4': case 'DEMUX_2': case 'DEMUX_4': case 'MUX_8':
            drawLogicSymbol(ctx, comp, th, pv);
            break;
          case 'BUZZER': {
            const on = pv.in0 === 1;
            ctx.fillStyle = on ? th.warn : th.subText;
            ctx.font = '800 12px monospace';
            ctx.fillText(on ? '♪ ON' : 'BUZ', 4, 0);
            break;
          }
          default: {
            // Puertas lógicas, Flip-Flops, MSI y Custom ICs
            const badgeMap = {
              BUFFER: 'BUF', NOT: 'NOT', AND: 'AND', NAND: 'NAND', OR: 'OR', NOR: 'NOR',
              XOR: 'XOR', XNOR: 'XNOR', TRI_BUFFER: '3-ST', SR_LATCH: 'SR', D_FF: 'D-FF',
              JK_FF: 'JK-FF', T_FF: 'T-FF', REG_4: 'REG4', COUNTER_4: 'CNT4',
              HALF_ADDER: 'HA', FULL_ADDER: 'FA', MUX_2: 'MUX2', MUX_4: 'MUX4',
              DEMUX_2: 'DMUX', BCD_7SEG: 'BCD7', COMP_2: 'CMP2', PROBE: 'CH'
            };
            const title = comp.type === 'CUSTOM_IC' ? (comp.label || 'IC') : (badgeMap[comp.type] || comp.type);
            const SYM = { HALF_ADDER: ['Σ', 'HA'], FULL_ADDER: ['Σ', 'FA'], COMP_2: ['=', 'CMP'], BCD_7SEG: ['8.', 'BCD→7'], SR_LATCH: ['SR', ''], D_FF: ['D', ''], JK_FF: ['JK', ''], T_FF: ['T', ''], REG_4: ['REG', ''], COUNTER_4: ['CTR', '÷16'] };
            const sym = SYM[comp.type] || (NEWC[comp.type] && NEWC[comp.type].sym);
            ctx.fillStyle = comp.type === 'CUSTOM_IC' ? th.sig1 : th.compText;
            if (sym) {
              ctx.font = '800 21px monospace';
              ctx.fillText(sym[0], 0, sym[1] ? -4 : 0);
              if (sym[1]) { ctx.fillStyle = th.subText; ctx.font = '800 9px monospace'; ctx.fillText(sym[1], 0, 15); }
              const ncs = NEWC[comp.type];
              if (ncs && ncs.show) { ctx.fillStyle = th.sig1; ctx.font = '800 13px monospace'; ctx.fillText(ncs.show(comp.internalState), 0, 36); }
            } else {
              ctx.font = '800 11.5px monospace';
              ctx.fillText(title, 0, 0);
            }
            break;
          }
        }

        // Etiquetas internas de pines en componentes complejos
        if (['RAM_16X4', 'ROM_16X4', 'FSM', 'ALU_4', 'SR_LATCH', 'D_FF', 'JK_FF', 'T_FF', 'REG_4', 'COUNTER_4', 'HALF_ADDER', 'FULL_ADDER', 'MUX_2', 'MUX_4', 'DEMUX_2', 'COMP_2', 'CUSTOM_IC'].includes(comp.type) || (NEWC[comp.type] && !NEWC[comp.type].noLabels)) {
          ctx.font = '700 8.5px monospace';
          ctx.fillStyle = th.subText;
          for (const p of comp.pins) {
            if (!p.label) continue;
            if (p.id === 'clk' && p.lx < -comp.w / 2 + 4) {
              ctx.beginPath(); ctx.moveTo(p.lx, p.ly - 5); ctx.lineTo(p.lx + 8, p.ly); ctx.lineTo(p.lx, p.ly + 5);
              ctx.strokeStyle = th.sig1; ctx.lineWidth = 1.4; ctx.stroke();
            }
            if (p.id === 'qn') {
              ctx.beginPath(); ctx.arc(p.lx - 4.5, p.ly, 3, 0, Math.PI * 2);
              ctx.strokeStyle = th.compText; ctx.lineWidth = 1.3; ctx.stroke();
            }
            if (p.lx < -comp.w / 2 + 4) {
              ctx.textAlign = 'left';
              ctx.fillText(p.label, p.lx + (p.id === 'clk' ? 12 : 7), p.ly);
            } else if (p.lx > comp.w / 2 - 4) {
              ctx.textAlign = 'right';
              ctx.fillText(p.label, p.lx - 7, p.ly);
            } else if (p.ly > comp.h / 2 - 4) {
              ctx.textAlign = 'center';
              ctx.fillText(p.label, p.lx, p.ly - 8);
            }
          }
        }

        // Etiqueta superior personalizada del usuario
        if (comp.label && comp.type !== 'CUSTOM_IC') {
          ctx.fillStyle = th.subText;
          ctx.font = '700 10.5px system-ui, sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText(comp.label, 0, -comp.h / 2 - 9);
        }

        // Indicador de Sonda activa
        if (comp.probe) {
          ctx.fillStyle = th.sig1;
          ctx.beginPath();
          ctx.arc(comp.w / 2 - 6, -comp.h / 2 + 6, 3.5, 0, Math.PI * 2);
          ctx.fill();
        }

        // Dibujar pines de entrada y salida
        for (const p of comp.pins) {
          const sig = pv[p.id];
          const isSnap = state.snapPin && state.snapPin.comp.id === comp.id && state.snapPin.pinId === p.id;
          const isHover = state.hoveredPin && state.hoveredPin.comp.id === comp.id && state.hoveredPin.pinId === p.id;

          ctx.beginPath();
          ctx.arc(p.lx, p.ly, isSnap || isHover ? 5.8 : 4.2, 0, Math.PI * 2);
          ctx.fillStyle = sig === 1 ? th.sig1 : (sig === 'Z' ? th.sigZ : (sig === 'ERR' ? th.sigErr : th.pinFill));
          ctx.fill();
          ctx.strokeStyle = isSnap || isHover ? '#ffffff' : th.pinStroke;
          ctx.lineWidth = isSnap || isHover ? 2 : 1.4;
          ctx.stroke();
        }

        if (oriented) delete ctx.fillText;
        ctx.restore();
      }

      function drawEffects(ctx) {
        for (const r of state.ripples) {
          ctx.save();
          ctx.strokeStyle = r.color;
          ctx.globalAlpha = Math.max(0, r.alpha);
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.arc(r.x, r.y, r.r, 0, Math.PI * 2);
          ctx.stroke();
          ctx.restore();
        }
        for (const s of state.sparks) {
          ctx.save();
          ctx.fillStyle = s.color;
          ctx.globalAlpha = Math.max(0, s.life / s.maxLife);
          ctx.beginPath();
          ctx.arc(s.x, s.y, 2.5, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        }
      }

      function drawPinTooltip(ctx) {
        const target = state.snapPin || state.hoveredPin;
        if (!target) return;
        const th = CANVAS_THEMES[state.theme];
        const sig = target.comp.pinValues[target.pinId] ?? 0;
        const col = getSignalColor(sig);
        const text = `${target.label || target.pinId}: ${sig}`;

        ctx.save();
        const z = state.view.zoom;
        const fs = Math.max(10, 11 / z);
        ctx.font = `700 ${fs}px monospace`;
        const padX = 7 / z;
        const boxH = 19 / z;
        const boxW = ctx.measureText(text).width + padX * 2;
        const bx = target.x - boxW / 2;
        const by = target.y - boxH - (9 / z);

        roundRectPath(ctx, bx, by, boxW, boxH, 5 / z);
        ctx.fillStyle = th.compFill;
        ctx.fill();
        ctx.strokeStyle = col;
        ctx.lineWidth = 1.4 / z;
        ctx.stroke();

        ctx.fillStyle = th.compText;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(text, bx + boxW / 2, by + boxH / 2);
        ctx.restore();
      }

      const RS = { dirty: true, until: 0, miniAt: 0, w: 0, h: 0, ro: null };
      function markDirty(ms) { RS.dirty = true; if (ms) RS.until = Math.max(RS.until, performance.now() + ms); }

      function setShadows(ctx, on) {
        if (on) {
          if (ctx.__noShadow) { delete ctx.shadowBlur; ctx.__noShadow = false; }
        } else if (!ctx.__noShadow) {
          Object.getOwnPropertyDescriptor(CanvasRenderingContext2D.prototype, 'shadowBlur').set.call(ctx, 0);
          Object.defineProperty(ctx, 'shadowBlur', { configurable: true, get() { return 0; }, set() {} });
          ctx.__noShadow = true;
        }
      }

      function renderMainCanvas() {
        const wrap = document.getElementById('canvas-wrapper');
        if (!wrap) return;
        if (!RS.ro) {
          const r = wrap.getBoundingClientRect();
          RS.w = r.width; RS.h = r.height;
          if (window.ResizeObserver) {
            RS.ro = new ResizeObserver(es => { const cr = es[0].contentRect; RS.w = cr.width; RS.h = cr.height; markDirty(250); });
            RS.ro.observe(wrap);
          } else RS.ro = true;
        }
        const W = RS.w, H = RS.h;
        const now = performance.now();
        const fast = now - FX.lastInteract < 140 || state.mode === 'PANNING' || state.view.targetX !== null;
        const q = SETTINGS.quality;
        const glow = q === 'high' ? true : q === 'low' ? false : !(FX.degraded || fast);
        const lowRes = q === 'low' || (q === 'auto' && FX.degraded && FX.ema > 40);
        const dpr = Math.min(window.devicePixelRatio || 1, lowRes ? 1.25 : 2);
        const bw = Math.floor(W * dpr), bh = Math.floor(H * dpr);
        if (mainCanvas.width !== bw || mainCanvas.height !== bh) { mainCanvas.width = bw; mainCanvas.height = bh; }

        const ctx = mainCtx;
        const th = CANVAS_THEMES[state.theme];
        setShadows(ctx, glow);

        ctx.save();
        ctx.scale(dpr, dpr);
        ctx.fillStyle = th.bg;
        ctx.fillRect(0, 0, W, H);

        // Rejilla de puntos (un solo trazo, con nivel de detalle según zoom)
        let step = 20 * state.view.zoom;
        while (step < 12 || (W / step) * (H / step) > 2600) step *= 2;
        const offsetX = ((state.view.x % step) + step) % step;
        const offsetY = ((state.view.y % step) + step) % step;
        ctx.fillStyle = th.gridDot;
        ctx.beginPath();
        for (let gx = offsetX; gx < W; gx += step) for (let gy = offsetY; gy < H; gy += step) ctx.rect(gx - 1, gy - 1, 2, 2);
        ctx.fill();

        ctx.translate(state.view.x, state.view.y);
        ctx.scale(state.view.zoom, state.view.zoom);
        const z = state.view.zoom;
        const vis = { x0: -state.view.x / z - 60, y0: -state.view.y / z - 60, x1: (W - state.view.x) / z + 60, y1: (H - state.view.y) / z + 60 };

        ctx.strokeStyle = th.gridAxis;
        ctx.lineWidth = 1 / z;
        ctx.beginPath();
        ctx.moveTo(-40, 0); ctx.lineTo(40, 0);
        ctx.moveTo(0, -40); ctx.lineTo(0, 40);
        ctx.stroke();

        drawWires(ctx, vis, fast);
        for (const comp of state.components) {
          const m = Math.max(comp.w, comp.h) / 2 + 40;
          if (comp.x + m < vis.x0 || comp.x - m > vis.x1 || comp.y + m < vis.y0 || comp.y - m > vis.y1) continue;
          drawComponent(ctx, comp);
        }
        drawEffects(ctx);
        drawPinTooltip(ctx);

        if (state.mode === 'MARQUEE' && state.marqueeRect) {
          const r = state.marqueeRect;
          ctx.fillStyle = 'rgba(0, 245, 212, 0.1)';
          ctx.strokeStyle = th.sig1;
          ctx.lineWidth = 1.2 / z;
          ctx.fillRect(r.x, r.y, r.w, r.h);
          ctx.strokeRect(r.x, r.y, r.w, r.h);
        }

        ctx.restore();
        if (now - RS.miniAt > 110) { RS.miniAt = now; renderMinimap(W, H); }
      }

      function renderMinimap(viewW, viewH) {
        const ctx = minimapCtx;
        const mw = minimapCanvas.width;
        const mh = minimapCanvas.height;
        const th = CANVAS_THEMES[state.theme];

        ctx.fillStyle = th.bg;
        ctx.fillRect(0, 0, mw, mh);

        if (state.components.length === 0) return;

        let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
        for (const c of state.components) {
          minX = Math.min(minX, c.x - 80);
          minY = Math.min(minY, c.y - 80);
          maxX = Math.max(maxX, c.x + 80);
          maxY = Math.max(maxY, c.y + 80);
        }
        const cw = Math.max(400, maxX - minX);
        const ch = Math.max(300, maxY - minY);
        const scale = Math.min((mw - 12) / cw, (mh - 12) / ch);
        const ox = (mw - cw * scale) / 2 - minX * scale;
        const oy = (mh - ch * scale) / 2 - minY * scale;

        for (const c of state.components) {
          ctx.fillStyle = state.selectedIds.has(c.id) ? th.sig1 : th.compStroke;
          ctx.fillRect(ox + (c.x - c.w / 2) * scale, oy + (c.y - c.h / 2) * scale, Math.max(3, c.w * scale), Math.max(2, c.h * scale));
        }

        // Rectángulo del viewport actual
        const topLeft = screenToWorld(0, 0);
        const botRight = screenToWorld(viewW, viewH);
        ctx.strokeStyle = th.sig1;
        ctx.lineWidth = 1.2;
        ctx.strokeRect(
          ox + topLeft.x * scale,
          oy + topLeft.y * scale,
          (botRight.x - topLeft.x) * scale,
          (botRight.y - topLeft.y) * scale
        );
      }

      // =========================================================================
      // 9. HIT-TESTING (PINES, COMPONENTES Y CABLES)
      // =========================================================================
      function hitTestPin(worldPos, radius = 12) {
        let best = null;
        let minD = radius;
        for (const c of state.components) {
          for (const wp of getWorldPins(c)) {
            const d = Math.hypot(wp.x - worldPos.x, wp.y - worldPos.y);
            if (d < minD) {
              minD = d;
              best = wp;
            }
          }
        }
        return best;
      }

      function findCompatibleSnapPin(worldPos, radius = 16) {
        if (!state.wiringFrom) return null;
        let best = null;
        let minD = radius;
        for (const c of state.components) {
          if (c.id === state.wiringFrom.compId) continue;
          for (const wp of getWorldPins(c)) {
            if (wp.dir === state.wiringFrom.dir) continue;
            const d = Math.hypot(wp.x - worldPos.x, wp.y - worldPos.y);
            if (d < minD) {
              minD = d;
              best = wp;
            }
          }
        }
        return best;
      }

      function hitTestComponent(worldPos) {
        for (let i = state.components.length - 1; i >= 0; i--) {
          const c = state.components[i];
          const odd = (c.rot || 0) % 2 === 1;
          if (Math.abs(worldPos.x - c.x) <= (odd ? c.h : c.w) / 2 && Math.abs(worldPos.y - c.y) <= (odd ? c.w : c.h) / 2) {
            return c;
          }
        }
        return null;
      }

      function hitTestWire(worldPos, tol = 8) {
        const compMap = new Map(), compIdx = new Map();
        state.components.forEach((c, i) => { compMap.set(c.id, c); compIdx.set(c.id, i); });
        for (let i = state.wires.length - 1; i >= 0; i--) {
          const w = state.wires[i];
          const cFrom = compMap.get(w.fromCompId), cTo = compMap.get(w.toCompId);
          if (!cFrom || !cTo) continue;
          const pFrom = cFrom.pins.find(p => p.id === w.fromPinId), pTo = cTo.pins.find(p => p.id === w.toPinId);
          if (!pFrom || !pTo) continue;
          const geom = getWireGeometry(pinWX(cFrom, pFrom), pinWY(cFrom, pFrom), pinWX(cTo, pTo), pinWY(cTo, pTo), wireLane(cFrom, pFrom, compIdx.get(cFrom.id)));
          const b = geomBounds(geom);
          if (worldPos.x < b.x0 - tol || worldPos.x > b.x1 + tol || worldPos.y < b.y0 - tol || worldPos.y > b.y1 + tol) continue;
          for (let s = 0; s <= 24; s++) {
            const pt = evalPointOnWire(geom, s / 24);
            if (Math.hypot(pt.x - worldPos.x, pt.y - worldPos.y) <= tol) return w;
          }
        }
        return null;
      }

      // =========================================================================
      // 10. BIBLIOTECA LATERAL E INSPECTOR DE PROPIEDADES
      // =========================================================================
      const thumbCache = new Map();
      function libThumb(type) {
        if (type === 'CUSTOM_IC') return null;
        const key = state.theme + '|' + type;
        if (thumbCache.has(key)) return thumbCache.get(key);
        let url = null;
        try {
          const c = createComponent(type, 0, 0, { noAnim: true });
          const cw = 84, ch = 56, dpr = 2;
          const cv = document.createElement('canvas');
          cv.width = cw * dpr; cv.height = ch * dpr;
          const cx = cv.getContext('2d');
          cx.scale(dpr, dpr);
          cx.translate(cw / 2, ch / 2);
          const k = Math.min(1, (cw - 6) / (c.w + 16), (ch - 4) / (c.h + 14));
          cx.scale(k, k);
          drawComponent(cx, c);
          url = cv.toDataURL();
        } catch (_) { url = null; }
        thumbCache.set(key, url);
        return url;
      }

      function renderComponentLibrary() {
        const container = document.getElementById('library-container');
        const query = (document.getElementById('component-search').value || '').trim().toLowerCase();
        const prevScroll = container.scrollTop;
        container.innerHTML = '';
        let shownCats = 0;

        for (const cat of CATEGORIES) {
          let items = [];
          if (cat === 'Mis Chips (IC)') {
            items = state.customICs.map(ic => ({
              type: 'CUSTOM_IC',
              icDefId: ic.id,
              badge: 'IC',
              name: ic.name
            }));
          } else {
            items = COMPONENT_CATALOG.filter(c => c.cat === cat);
          }

          if (query) {
            items = items.filter(it => it.name.toLowerCase().includes(query) || it.badge.toLowerCase().includes(query));
          }

          if (items.length === 0 && cat !== 'Mis Chips (IC)') continue;

          const isCollapsed = state.collapsedCats.has(cat) && !query;
          const box = document.createElement('div');
          box.className = 'lib-category';

          const header = document.createElement('button');
          header.className = 'lib-cat-header';
          header.innerHTML = `<span>${cat} (${items.length})</span><span class="chev ${isCollapsed ? '' : 'open'}">▸</span>`;
          header.setAttribute('aria-expanded', String(!isCollapsed));
          header.onclick = () => {
            if (state.collapsedCats.has(cat)) { state.collapsedCats.delete(cat); state.animCat = cat; }
            else state.collapsedCats.add(cat);
            renderComponentLibrary();
          };
          box.appendChild(header);

          if (!isCollapsed) {
            const grid = document.createElement('div');
            grid.className = 'lib-cat-grid' + (state.animCat === cat ? ' anim' : '');

            if (items.length === 0 && cat === 'Mis Chips (IC)') {
              const emptyMsg = document.createElement('div');
              emptyMsg.style.cssText = 'grid-column:1/-1; font-size:10.5px; color:var(--text-muted); padding:4px; text-align:center;';
              emptyMsg.textContent = 'Usa "Crear IC" en la barra superior para guardar bloques.';
              grid.appendChild(emptyMsg);
            } else {
              for (const it of items) {
                const card = document.createElement('div');
                card.className = 'lib-item';
                card.draggable = true;
                const thumb = libThumb(it.type);
                card.title = it.name;
                card.innerHTML = thumb
                  ? `<img class="lib-thumb" src="${thumb}" alt="" draggable="false"><span class="lib-item-name">${it.name}</span>`
                  : `<span class="lib-item-badge mono">${it.badge}</span><span class="lib-item-name">${it.name}</span>`;
                card.ondragstart = (e) => {
                  e.dataTransfer.setData('application/json', JSON.stringify({ type: it.type, icDefId: it.icDefId || null }));
                };
                card.onclick = () => {
                  const wrap = document.getElementById('canvas-wrapper').getBoundingClientRect();
                  const centerWorld = screenToWorld(wrap.width / 2 + (Math.random() - 0.5) * 40, wrap.height / 2 + (Math.random() - 0.5) * 40);
                  addComponentToCanvas(it.type, centerWorld.x, centerWorld.y, { icDefId: it.icDefId || null });
                };
                grid.appendChild(card);
              }
            }
            box.appendChild(grid);
          }

          container.appendChild(box);
          shownCats++;
        }
        state.animCat = null;
        if (shownCats === 0) {
          const none = document.createElement('div');
          none.className = 'lib-empty';
          none.textContent = 'Sin resultados para "' + query + '"';
          container.appendChild(none);
        }
        container.scrollTop = prevScroll;
      }

      function setLibraryHidden(hide) {
        document.getElementById('sidebar-left').classList.toggle('collapsed', hide);
        document.getElementById('btn-lib-show').classList.toggle('show', hide);
      }

      function addComponentToCanvas(type, wx, wy, options = {}) {
        const comp = createComponent(type, wx, wy, options);
        state.components.push(comp);
        state.selectedIds = new Set([comp.id]);
        state.selectedWireId = null;
        spawnRipple(comp.x, comp.y);
        soundFX.playPop(780);
        evaluateCircuitDeterministic(state.components, state.wires, 0);
        saveHistorySnapshot();
        updateInspector();
        updateStatusBar();
      }

      function updateInspector() {
        const panel = document.getElementById('sidebar-right');
        const body = document.getElementById('inspector-body');
        const title = document.getElementById('inspector-title');

        if (state.selectedIds.size === 0 && !state.selectedWireId) {
          panel.classList.add('hidden');
          return;
        }

        panel.classList.remove('hidden');

        if (state.selectedWireId) {
          title.textContent = 'Conductor Seleccionado';
          body.innerHTML = `
            <p style="font-size:12px; color:var(--text-secondary);">Conexión lógica punto a punto.</p>
            <button id="insp-del-wire" class="btn btn-danger">Eliminar Conductor (Supr)</button>
          `;
          document.getElementById('insp-del-wire').onclick = deleteSelection;
          return;
        }

        if (state.selectedIds.size > 1) {
          title.textContent = `${state.selectedIds.size} Seleccionados`;
          body.innerHTML = `
            <div class="field-group">
              <label class="field-label">Alinear selección</label>
              <div class="tool-grid">
                <button class="btn" data-al="left" title="Alinear a la izquierda">⇤</button>
                <button class="btn" data-al="hcenter" title="Centrar horizontalmente">↔</button>
                <button class="btn" data-al="right" title="Alinear a la derecha">⇥</button>
                <button class="btn" data-al="top" title="Alinear arriba">⤒</button>
                <button class="btn" data-al="vcenter" title="Centrar verticalmente">↕</button>
                <button class="btn" data-al="bottom" title="Alinear abajo">⤓</button>
                <button class="btn" data-al="dist-h" title="Distribuir horizontalmente (3+)">⇹ Dist. H</button>
                <button class="btn" data-al="dist-v" title="Distribuir verticalmente (3+)">⇳ Dist. V</button>
              </div>
            </div>
            <div class="field-group">
              <label class="field-label">Orientación</label>
              <div class="tool-grid two">
                <button id="insp-rot-multi" class="btn">⟳ Rotar (R)</button>
                <button id="insp-flip-multi" class="btn">⇋ Voltear (H)</button>
              </div>
            </div>
            <button id="insp-dup-multi" class="btn">Duplicar Selección (Ctrl+D)</button>
            <button id="insp-del-multi" class="btn btn-danger">Eliminar Selección (Supr)</button>
          `;
          body.querySelectorAll('[data-al]').forEach(b => { b.onclick = () => alignSelection(b.dataset.al); });
          document.getElementById('insp-rot-multi').onclick = () => rotateSelection(1);
          document.getElementById('insp-flip-multi').onclick = flipSelection;
          document.getElementById('insp-dup-multi').onclick = duplicateSelection;
          document.getElementById('insp-del-multi').onclick = deleteSelection;
          return;
        }

        const compId = [...state.selectedIds][0];
        const comp = state.components.find(c => c.id === compId);
        if (!comp) {
          panel.classList.add('hidden');
          return;
        }

        const meta = COMPONENT_CATALOG.find(m => m.type === comp.type);
        title.textContent = meta ? meta.name : comp.type;

        let html = '';

        if (comp.type === 'LABEL') {
          html += `
            <div class="field-group">
              <label class="field-label">Texto de la Nota</label>
              <input id="insp-note" type="text" class="input-control" value="${comp.noteText}" />
            </div>
          `;
        } else {
          html += `
            <div class="field-group">
              <label class="field-label">Etiqueta del Componente</label>
              <input id="insp-label" type="text" class="input-control" placeholder="Ej: A, CLK, SALIDA" value="${comp.label}" />
            </div>
          `;
        }

        if (meta && meta.variableInputs) {
          html += `
            <div class="field-group">
              <label class="field-label">${comp.type === 'SEG7_MULTI' ? 'Número de Dígitos (2 a 4)' : 'Número de Entradas (2 a 4)'}</label>
              <select id="insp-inputs" class="select-control">
                <option value="2" ${comp.inputCount === 2 ? 'selected' : ''}>2 ${comp.type === 'SEG7_MULTI' ? 'Dígitos' : 'Entradas'}</option>
                <option value="3" ${comp.inputCount === 3 ? 'selected' : ''}>3 ${comp.type === 'SEG7_MULTI' ? 'Dígitos' : 'Entradas'}</option>
                <option value="4" ${comp.inputCount === 4 ? 'selected' : ''}>4 ${comp.type === 'SEG7_MULTI' ? 'Dígitos' : 'Entradas'}</option>
              </select>
            </div>
          `;
        }

        if (['LED', 'SEG7_DISPLAY', 'SEG7_MULTI', 'HEX_DISPLAY', 'LED_BAR_4'].includes(comp.type)) {
          html += `
            <div class="field-group">
              <label class="field-label">Color del Indicador</label>
              <div class="color-swatches">
                ${Object.entries(LED_PALETTE).map(([k, v]) => `
                  <button data-col="${k}" title="${v.name}" class="swatch-btn ${comp.color === k ? 'active' : ''}" style="background:${v.hex};"></button>
                `).join('')}
              </div>
            </div>
          `;
        }

        if (comp.type === 'CLOCK') {
          const curHz = comp.freqHz !== null ? comp.freqHz : state.globalClockHz;
          html += `
            <div class="field-group">
              <label class="field-label">Frecuencia Propia (${curHz.toFixed(1)} Hz)</label>
              <input id="insp-hz" type="range" min="0.5" max="15" step="0.5" value="${curHz}" style="accent-color:var(--accent);" />
            </div>
          `;
        }

        if (comp.type === 'PULSE_GEN') {
          html += `
            <div class="field-group">
              <label class="field-label">Secuencia Programable de 8 Bits</label>
              <div class="seq-bits-row">
                ${comp.internalState.seqBits.map((b, idx) => `
                  <button data-bidx="${idx}" class="seq-bit-btn mono ${b === 1 ? 'on' : ''}">${b}</button>
                `).join('')}
              </div>
            </div>
          `;
        }

        if (comp.type !== 'LABEL') {
          html += `
            <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:12px;">
              <input id="insp-probe" type="checkbox" ${comp.probe ? 'checked' : ''} style="accent-color:var(--accent);" />
              <span>Mostrar en Osciloscopio</span>
            </label>
          `;
        }

        if (comp.type === 'RAM_16X4' || comp.type === 'ROM_16X4') {
          if (!comp.internalState.mem) comp.internalState.mem = new Array(16).fill(0);
          html += `
            <div class="field-group">
              <label class="field-label">Contenido de memoria (hex, 16 palabras de 4 bits)</label>
              <div class="mem-grid">
                ${comp.internalState.mem.map((v, i) => `
                  <label class="mem-cell"><span class="mono">${i.toString(16).toUpperCase()}</span><input data-maddr="${i}" class="input-control mono" maxlength="1" value="${(v & 15).toString(16).toUpperCase()}" /></label>
                `).join('')}
              </div>
              <div class="tool-grid two">
                <button id="mem-zero" class="btn">Poner a 0</button>
                <button id="mem-count" class="btn">Cargar 0…F</button>
              </div>
            </div>
          `;
        }

        if (comp.type === 'FSM') {
          const f = comp.internalState.fsm;
          const opt = (sel) => Array.from({ length: f.n }, (_, k) => `<option value="${k}" ${sel === k ? 'selected' : ''}>S${k}</option>`).join('');
          html += `
            <div class="field-group">
              <label class="field-label">Número de estados</label>
              <select id="fsm-n" class="select-control">
                ${[2, 3, 4, 5, 6, 7, 8].map(k => `<option value="${k}" ${f.n === k ? 'selected' : ''}>${k} estados</option>`).join('')}
              </select>
            </div>
            <div class="field-group">
              <label class="field-label">Tabla de transiciones (Moore)</label>
              <div class="fsm-table">
                <div class="fsm-row head"><span></span><span>X=0 →</span><span>X=1 →</span><span>Z</span></div>
                ${Array.from({ length: f.n }, (_, i) => `
                  <div class="fsm-row">
                    <span class="mono">S${i}</span>
                    <select data-fsm="n0" data-i="${i}" class="select-control">${opt(f.next0[i])}</select>
                    <select data-fsm="n1" data-i="${i}" class="select-control">${opt(f.next1[i])}</select>
                    <input data-fsm="out" data-i="${i}" type="checkbox" ${f.out[i] ? 'checked' : ''} style="accent-color:var(--accent);" />
                  </div>`).join('')}
              </div>
              <button id="fsm-reset" class="btn">Volver al estado S0</button>
            </div>
          `;
        }

        if (comp.type !== 'LABEL') {
          html += `
            <div class="field-group">
              <label class="field-label">Orientación</label>
              <div class="tool-grid two">
                <button id="insp-rot" class="btn">⟳ Rotar (R)</button>
                <button id="insp-flip" class="btn">⇋ Voltear (H)</button>
              </div>
            </div>
          `;
        }

        html += `
          <div style="display:flex; flex-direction:column; gap:6px; margin-top:6px;">
            <button id="insp-dup" class="btn">Duplicar (Ctrl+D)</button>
            <button id="insp-del" class="btn btn-danger">Eliminar (Supr)</button>
          </div>
        `;

        body.innerHTML = html;

        const noteInp = document.getElementById('insp-note');
        if (noteInp) noteInp.oninput = (e) => { comp.noteText = e.target.value; }; if (noteInp) noteInp.onchange = saveHistorySnapshot;

        const lblInp = document.getElementById('insp-label');
        if (lblInp) lblInp.oninput = (e) => { comp.label = e.target.value; }; if (lblInp) lblInp.onchange = saveHistorySnapshot;

        const inpSel = document.getElementById('insp-inputs');
        if (inpSel) {
          inpSel.onchange = (e) => {
            comp.inputCount = Number(e.target.value);
            syncComponentPins(comp);
            const validIds = new Set(comp.pins.map(p => p.id));
            state.wires = state.wires.filter(w => !(w.toCompId === comp.id && !validIds.has(w.toPinId)));
            evaluateCircuitDeterministic(state.components, state.wires, 0);
            saveHistorySnapshot();
          };
        }

        body.querySelectorAll('.swatch-btn').forEach(btn => {
          btn.onclick = () => {
            comp.color = btn.dataset.col;
            saveHistorySnapshot();
            updateInspector();
          };
        });

        const hzInp = document.getElementById('insp-hz');
        if (hzInp) {
          hzInp.oninput = (e) => {
            comp.freqHz = Number(e.target.value);
            updateInspector();
          };
          hzInp.onchange = saveHistorySnapshot;
        }

        body.querySelectorAll('.seq-bit-btn').forEach(btn => {
          btn.onclick = () => {
            const idx = Number(btn.dataset.bidx);
            comp.internalState.seqBits[idx] = comp.internalState.seqBits[idx] === 1 ? 0 : 1;
            evaluateCircuitDeterministic(state.components, state.wires, 0);
            saveHistorySnapshot();
            updateInspector();
          };
        });

        const probeChk = document.getElementById('insp-probe');
        if (probeChk) {
          probeChk.onchange = (e) => {
            comp.probe = e.target.checked;
            saveHistorySnapshot();
          };
        }

        const rotBtn = document.getElementById('insp-rot');
        if (rotBtn) rotBtn.onclick = () => rotateSelection(1);
        const flipBtn = document.getElementById('insp-flip');
        if (flipBtn) flipBtn.onclick = flipSelection;

        body.querySelectorAll('[data-maddr]').forEach(inp => {
          inp.onfocus = () => inp.select();
          inp.onchange = () => {
            const v = parseInt(inp.value, 16);
            comp.internalState.mem[Number(inp.dataset.maddr)] = isNaN(v) ? 0 : (v & 15);
            inp.value = (comp.internalState.mem[Number(inp.dataset.maddr)]).toString(16).toUpperCase();
            evaluateCircuitDeterministic(state.components, state.wires, 0);
            saveHistorySnapshot();
          };
        });
        const memZero = document.getElementById('mem-zero');
        if (memZero) memZero.onclick = () => { comp.internalState.mem = new Array(16).fill(0); evaluateCircuitDeterministic(state.components, state.wires, 0); saveHistorySnapshot(); updateInspector(); };
        const memCount = document.getElementById('mem-count');
        if (memCount) memCount.onclick = () => { comp.internalState.mem = Array.from({ length: 16 }, (_, i) => i); evaluateCircuitDeterministic(state.components, state.wires, 0); saveHistorySnapshot(); updateInspector(); };

        const fsmN = document.getElementById('fsm-n');
        if (fsmN) {
          fsmN.onchange = (e) => {
            const f = comp.internalState.fsm, n = Number(e.target.value);
            const fit = (arr, def) => Array.from({ length: n }, (_, i) => (i < arr.length ? arr[i] : def(i)));
            f.next0 = fit(f.next0, i => i).map(v => v % n);
            f.next1 = fit(f.next1, i => (i + 1) % n).map(v => v % n);
            f.out = fit(f.out, () => 0);
            f.n = n;
            if ((comp.internalState.fsmState || 0) >= n) comp.internalState.fsmState = 0;
            evaluateCircuitDeterministic(state.components, state.wires, 0);
            saveHistorySnapshot();
            updateInspector();
          };
          body.querySelectorAll('[data-fsm]').forEach(el => {
            el.onchange = () => {
              const f = comp.internalState.fsm, i = Number(el.dataset.i);
              if (el.dataset.fsm === 'n0') f.next0[i] = Number(el.value);
              else if (el.dataset.fsm === 'n1') f.next1[i] = Number(el.value);
              else f.out[i] = el.checked ? 1 : 0;
              evaluateCircuitDeterministic(state.components, state.wires, 0);
              saveHistorySnapshot();
            };
          });
          document.getElementById('fsm-reset').onclick = () => { comp.internalState.fsmState = 0; evaluateCircuitDeterministic(state.components, state.wires, 0); };
        }

        document.getElementById('insp-dup').onclick = duplicateSelection;
        document.getElementById('insp-del').onclick = deleteSelection;
      }

      // =========================================================================
      // 11. HISTORIAL (DESHACER / REHACER), PORTAPAPELES Y EDICIÓN
      // =========================================================================
      const AUTOSAVE_KEY = 'logicstudio_pro_beta02_autosave';
      const PREFS_KEY = 'logicstudio_pro_beta02_prefs';
      let autosaveTimer = null;
      function scheduleAutosave(snap) {
        clearTimeout(autosaveTimer);
        autosaveTimer = setTimeout(() => {
          let saved = true;
          try { localStorage.setItem(AUTOSAVE_KEY, snap); } catch (_) { saved = false; }
          const pill = document.getElementById('autosave-pill');
          if (pill) {
            pill.textContent = saved ? `💾 Guardado ${new Date().toLocaleTimeString()}` : '⚠ Sin autoguardado';
            pill.classList.remove('flash'); void pill.offsetWidth; pill.classList.add('flash');
          }
        }, 600);
      }
      function savePrefs() {
        try { localStorage.setItem(PREFS_KEY, JSON.stringify({ theme: state.theme, wireStyle: state.wireStyle, sound: soundFX.enabled, hz: state.globalClockHz, settings: SETTINGS, libHidden: document.getElementById('sidebar-left').classList.contains('collapsed') })); } catch (_) {}
      }

      function saveHistorySnapshot() {
        const snap = JSON.stringify({
          components: state.components,
          wires: state.wires,
          customICs: state.customICs
        }, (k, v) => (k === 'spawnScale' || k === 'spawnVel') ? undefined : v);
        if (state.history[state.historyIndex] === snap) return;
        scheduleAutosave(snap);
        if (state.historyIndex < state.history.length - 1) {
          state.history = state.history.slice(0, state.historyIndex + 1);
        }
        state.history.push(snap);
        if (state.history.length > 45) state.history.shift();
        state.historyIndex = state.history.length - 1;
        updateHistoryButtons();
        updateStatusBar();
      }

      function restoreSnapshot(snapStr) {
        const data = JSON.parse(snapStr);
        state.components = data.components || [];
        state.wires = data.wires || [];
        if (data.customICs) state.customICs = data.customICs;
        state.selectedIds.clear();
        state.selectedWireId = null;
        evaluateCircuitDeterministic(state.components, state.wires, 0);
        renderComponentLibrary();
        updateInspector();
        updateHistoryButtons();
        updateStatusBar();
      }

      function undo() {
        if (state.historyIndex <= 0) return;
        state.historyIndex--;
        restoreSnapshot(state.history[state.historyIndex]);
        showToast('Deshecho');
      }

      function redo() {
        if (state.historyIndex >= state.history.length - 1) return;
        state.historyIndex++;
        restoreSnapshot(state.history[state.historyIndex]);
        showToast('Rehecho');
      }

      function updateHistoryButtons() {
        document.getElementById('btn-undo').disabled = state.historyIndex <= 0;
        document.getElementById('btn-redo').disabled = state.historyIndex >= state.history.length - 1;
      }

      function deleteSelection() {
        if (state.selectedWireId) {
          state.wires = state.wires.filter(w => w.id !== state.selectedWireId);
          state.selectedWireId = null;
          soundFX.playClick(false);
          evaluateCircuitDeterministic(state.components, state.wires, 0);
          saveHistorySnapshot();
          updateInspector();
          return;
        }
        if (state.selectedIds.size > 0) {
          for (const id of state.selectedIds) {
            const c = state.components.find(x => x.id === id);
            if (c) spawnSparks(c.x, c.y);
          }
          state.components = state.components.filter(c => !state.selectedIds.has(c.id));
          state.wires = state.wires.filter(w => !state.selectedIds.has(w.fromCompId) && !state.selectedIds.has(w.toCompId));
          state.selectedIds.clear();
          soundFX.playClick(false);
          evaluateCircuitDeterministic(state.components, state.wires, 0);
          saveHistorySnapshot();
          updateInspector();
        }
      }

      function spawnClones(srcComps, srcWires, offset) {
        const idMap = new Map();
        const newComps = [];
        for (const orig of srcComps) {
          const clone = JSON.parse(JSON.stringify(orig));
          clone.id = genId('c');
          clone.x += offset;
          clone.y += offset;
          clone.spawnScale = 0.2;
          clone.spawnVel = 8.5;
          if (clone.type === 'CUSTOM_IC') {
            const def = state.customICs.find(d => d.id === clone.icDefId) || clone.icSnapshot;
            if (def) clone.internalState.subState = cloneCleanSubNetlist(def.netlist);
          }
          idMap.set(orig.id, clone.id);
          newComps.push(clone);
        }
        const newWires = srcWires.filter(w => idMap.has(w.fromCompId) && idMap.has(w.toCompId)).map(w => ({
          id: genId('w'),
          fromCompId: idMap.get(w.fromCompId),
          fromPinId: w.fromPinId,
          toCompId: idMap.get(w.toCompId),
          toPinId: w.toPinId,
          signal: 0
        }));
        state.components.push(...newComps);
        state.wires.push(...newWires);
        state.selectedIds = new Set(newComps.map(c => c.id));
        state.selectedWireId = null;
        soundFX.playPop(720);
        evaluateCircuitDeterministic(state.components, state.wires, 0);
        saveHistorySnapshot();
        updateInspector();
        updateStatusBar();
      }

      function duplicateSelection() {
        if (state.selectedIds.size === 0) return;
        const comps = state.components.filter(c => state.selectedIds.has(c.id));
        spawnClones(comps, state.wires, 24);
      }

      function copySelection(cut = false) {
        if (state.selectedIds.size === 0) return;
        const comps = state.components.filter(c => state.selectedIds.has(c.id));
        const wires = state.wires.filter(w => state.selectedIds.has(w.fromCompId) && state.selectedIds.has(w.toCompId));
        state.clipboard = JSON.parse(JSON.stringify({ comps, wires }));
        state.pasteOffsetCount = 0;
        showToast(cut ? 'Cortado' : `Copiado (${comps.length})`);
        if (cut) deleteSelection();
      }

      function pasteClipboard() {
        if (!state.clipboard || !state.clipboard.comps.length) { showToast('Portapapeles vacío', 'warn'); return; }
        state.pasteOffsetCount++;
        spawnClones(state.clipboard.comps, state.clipboard.wires, 24 * state.pasteOffsetCount);
      }

      function rotateSelection(dir = 1) {
        const cs = state.components.filter(c => state.selectedIds.has(c.id) && c.type !== 'LABEL');
        if (!cs.length) return;
        cs.forEach(c => { c.rot = (((c.rot || 0) + dir) % 4 + 4) % 4; });
        soundFX.playClick(true);
        saveHistorySnapshot();
      }

      function flipSelection() {
        const cs = state.components.filter(c => state.selectedIds.has(c.id) && c.type !== 'LABEL');
        if (!cs.length) return;
        cs.forEach(c => { c.flip = !c.flip; });
        soundFX.playClick(true);
        saveHistorySnapshot();
      }

      function alignSelection(mode) {
        const cs = state.components.filter(c => state.selectedIds.has(c.id));
        if (cs.length < 2) return;
        const ext = c => { const o = (c.rot || 0) % 2 === 1; return { hw: (o ? c.h : c.w) / 2, hh: (o ? c.w : c.h) / 2 }; };
        const minL = Math.min(...cs.map(c => c.x - ext(c).hw)), maxR = Math.max(...cs.map(c => c.x + ext(c).hw));
        const minT = Math.min(...cs.map(c => c.y - ext(c).hh)), maxB = Math.max(...cs.map(c => c.y + ext(c).hh));
        const g = v => Math.round(v / 10) * 10;
        if (mode === 'dist-h' || mode === 'dist-v') {
          if (cs.length < 3) { showToast('Distribuir necesita 3 o más componentes', 'warn'); return; }
          const key = mode === 'dist-h' ? 'x' : 'y';
          cs.sort((a, b) => a[key] - b[key]);
          const first = cs[0][key], step = (cs[cs.length - 1][key] - first) / (cs.length - 1);
          cs.forEach((c, i) => { c[key] = g(first + i * step); });
        } else {
          cs.forEach(c => {
            const e = ext(c);
            if (mode === 'left') c.x = g(minL + e.hw);
            else if (mode === 'right') c.x = g(maxR - e.hw);
            else if (mode === 'hcenter') c.x = g((minL + maxR) / 2);
            else if (mode === 'top') c.y = g(minT + e.hh);
            else if (mode === 'bottom') c.y = g(maxB - e.hh);
            else if (mode === 'vcenter') c.y = g((minT + maxB) / 2);
          });
        }
        soundFX.playPop(640);
        saveHistorySnapshot();
      }

      function nudgeSelection(dx, dy) {
        if (state.selectedIds.size === 0) return;
        for (const c of state.components) if (state.selectedIds.has(c.id)) { c.x += dx; c.y += dy; }
        clearTimeout(state.nudgeTimer);
        state.nudgeTimer = setTimeout(saveHistorySnapshot, 350);
      }

      function centerAndFitView() {
        const wrap = document.getElementById('canvas-wrapper').getBoundingClientRect();
        if (state.components.length === 0) {
          state.view.targetX = wrap.width / 2;
          state.view.targetY = wrap.height / 2;
          state.view.targetZoom = 1;
          return;
        }
        let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
        for (const c of state.components) {
          minX = Math.min(minX, c.x - c.w / 2 - 40);
          minY = Math.min(minY, c.y - c.h / 2 - 40);
          maxX = Math.max(maxX, c.x + c.w / 2 + 40);
          maxY = Math.max(maxY, c.y + c.h / 2 + 40);
        }
        const cw = Math.max(200, maxX - minX);
        const ch = Math.max(160, maxY - minY);
        const targetZoom = Math.max(0.45, Math.min(1.25, Math.min((wrap.width - 80) / cw, (wrap.height - 80) / ch)));
        const cx = (minX + maxX) / 2;
        const cy = (minY + maxY) / 2;
        state.view.targetZoom = targetZoom;
        state.view.targetX = wrap.width / 2 - cx * targetZoom;
        state.view.targetY = wrap.height / 2 - cy * targetZoom;
      }

