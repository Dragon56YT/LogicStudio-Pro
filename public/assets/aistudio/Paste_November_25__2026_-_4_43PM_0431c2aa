          { set: { X: 1 }, pulse: true, expect: { Z: 0 } }, { set: { X: 0 }, pulse: true, expect: { Z: 0 } }, { set: { X: 1 }, pulse: true, expect: { Z: 1 } }, { set: { X: 0 }, pulse: true, expect: { Z: 0 } }, { set: { X: 1 }, pulse: true, expect: { Z: 1 } }, { set: { X: 1 }, pulse: true, expect: { Z: 0 } }])
