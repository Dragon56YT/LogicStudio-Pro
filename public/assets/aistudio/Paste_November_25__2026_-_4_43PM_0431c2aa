      const findLabeled = (name, types) => state.components.find(c => types.includes(c.type) && (c.label || '').trim().toUpperCase() === name.toUpperCase());

      function resetSeqState() {
        state.components.forEach(c => {
          const s = c.internalState;
          s.q = 0; s.qn = 1; s.reg = [0, 0, 0, 0]; s.count = 0; s.prevClk = 0; s.fsmState = 0; s.seqIdx = 0; s.clockTimer = 0; s.clockOut = 0;
        });
      }

      function validateChallenge(ch) {
        const ins = ch.inputs.map(n => ({ n, c: findLabeled(n, ['SWITCH']) }));
        const outs = ch.outputs.map(n => ({ n, c: findLabeled(n, ['LED', 'PROBE']) }));
        const missing = [...ins.filter(x => !x.c).map(x => `Interruptor "${x.n}"`), ...outs.filter(x => !x.c).map(x => `LED "${x.n}"`)];
        if (missing.length) return { ok: false, missing, rows: [] };
        const settle = () => { for (let k = 0; k < 4; k++) evaluateCircuitDeterministic(state.components, state.wires, 0); };
        const saved = ins.map(x => x.c.internalState.value);
        const read = () => outs.map(x => (x.c.pinValues.in0 === 1 ? 1 : 0));
        const fmt = (names, vals) => names.map((n, i) => `${n}=${vals[i] === null || vals[i] === undefined ? 'x' : vals[i]}`).join(' ');
        const rows = [];
        if (ch.steps) {
          ins.forEach(x => { x.c.internalState.value = 0; });
          resetSeqState(); settle();
          const clk = ins.find(x => x.n.toUpperCase() === 'CLK');
          ch.steps.forEach(stp => {
            Object.entries(stp.set || {}).forEach(([n, v]) => { const x = ins.find(q => q.n.toUpperCase() === n.toUpperCase()); if (x) x.c.internalState.value = v; });
            settle();
            if (stp.pulse && clk) { clk.c.internalState.value = 1; settle(); clk.c.internalState.value = 0; settle(); }
            const got = read();
            const exp = outs.map(x => stp.expect[x.n]);
            const label = [Object.entries(stp.set || {}).map(([k, v]) => `${k}=${v}`).join(' '), stp.pulse ? '⏵CLK' : ''].filter(Boolean).join(' ');
            rows.push({ label, exp: fmt(ch.outputs, exp), got: fmt(ch.outputs, got), ok: exp.every((v, i) => v === undefined || v === got[i]) });
          });
          resetSeqState();
        } else {
          const total = 1 << ins.length;
          for (let m = 0; m < total; m++) {
            const bits = ins.map((_, i) => (m >> (ins.length - 1 - i)) & 1);
            ins.forEach((x, i) => { x.c.internalState.value = bits[i]; });
            settle();
            const got = read();
            const exp = ch.fn(bits);
            rows.push({ label: fmt(ch.inputs, bits), exp: fmt(ch.outputs, exp), got: fmt(ch.outputs, got), ok: exp.every((v, i) => v === null || v === got[i]) });
          }
        }
        ins.forEach((x, i) => { x.c.internalState.value = saved[i]; });
        settle();
        return { ok: rows.every(r => r.ok), missing: [], rows };
