      // =========================================================================
      // 12. HERRAMIENTAS AVANZADAS: SINTETIZADOR BOOLEANO, TABLA DE VERDAD Y IC
      // =========================================================================
      function synthesizeBooleanExpression(exprRaw) {
        let s = exprRaw.trim();
        if (!s) throw new Error('Introduce una expresión booleana.');

        // Normalizar operadores en español/inglés/símbolos
        s = s
          .replace(/\bXNOR\b/gi, ' XNOR ')
          .replace(/\bNAND\b/gi, ' NAND ')
          .replace(/\bNOR\b/gi, ' NOR ')
          .replace(/\bXOR\b/gi, ' XOR ')
          .replace(/\bAND\b/gi, ' AND ')
          .replace(/\bOR\b/gi, ' OR ')
          .replace(/\bNOT\b/gi, ' NOT ')
          .replace(/&&|\*|·|&/g, ' AND ')
          .replace(/\|\||\+|\|/g, ' OR ')
          .replace(/!|~/g, ' NOT ')
          .replace(/\^/g, ' XOR ');

        const tokens = s.match(/\(|\)|XNOR|NAND|NOR|XOR|AND|OR|NOT|[A-Za-z][A-Za-z0-9_]*/g);
        if (!tokens || tokens.length === 0) throw new Error('Expresión no válida.');

        let pos = 0;
        const varsSet = new Set();
        const ops = new Set(['AND', 'NAND', 'OR', 'NOR', 'XOR', 'XNOR', 'NOT', '(', ')']);

        function parseOr() {
          let node = parseXor();
          while (pos < tokens.length && (tokens[pos] === 'OR' || tokens[pos] === 'NOR')) {
            const op = tokens[pos++];
            node = { type: op, left: node, right: parseXor() };
          }
          return node;
        }
        function parseXor() {
          let node = parseAnd();
          while (pos < tokens.length && (tokens[pos] === 'XOR' || tokens[pos] === 'XNOR')) {
            const op = tokens[pos++];
            node = { type: op, left: node, right: parseAnd() };
          }
          return node;
        }
        function parseAnd() {
          let node = parseNot();
          while (pos < tokens.length && (tokens[pos] === 'AND' || tokens[pos] === 'NAND')) {
            const op = tokens[pos++];
            node = { type: op, left: node, right: parseNot() };
          }
          return node;
        }
        function parseNot() {
          if (pos < tokens.length && tokens[pos] === 'NOT') {
            pos++;
            return { type: 'NOT', child: parseNot() };
          }
          return parsePrimary();
        }
        function parsePrimary() {
          if (pos >= tokens.length) throw new Error('Falta un operando al final.');
          const tok = tokens[pos++];
          if (tok === '(') {
            const inner = parseOr();
            if (tokens[pos] !== ')') throw new Error('Paréntesis sin cerrar.');
            pos++;
            return inner;
          }
          if (ops.has(tok)) throw new Error(`Operador inesperado: ${tok}`);
          const vName = tok.toUpperCase();
          varsSet.add(vName);
          return { type: 'VAR', name: vName };
        }

        const ast = parseOr();
        if (pos < tokens.length) throw new Error(`Token inesperado: ${tokens[pos]}`);

        const varNames = [...varsSet].sort();
        if (varNames.length > 8) throw new Error('Máximo 8 variables distintas permitidas.');

        state.components = [];
        state.wires = [];
        state.analyzerSamples = [];

        const varCompMap = new Map();
        varNames.forEach((vName, idx) => {
          const sw = createComponent('SWITCH', -280, -((varNames.length - 1) * 70) / 2 + idx * 70, { label: vName, initialValue: 1 });
          state.components.push(sw);
          varCompMap.set(vName, sw);
        });

        let colCounter = 0;
        const depthCounters = new Map();

        function buildNode(node, depth) {
          if (node.type === 'VAR') {
            return varCompMap.get(node.name);
          }
          const row = depthCounters.get(depth) || 0;
          depthCounters.set(depth, row + 1);
          const gx = -120 + depth * 130;
          const gy = (row - 0.5) * 85;
          colCounter = Math.max(colCounter, depth);

          if (node.type === 'NOT') {
            const childComp = buildNode(node.child, depth - 1);
            const gate = createComponent('NOT', gx, gy);
            state.components.push(gate);
            state.wires.push({ id: genId('w'), fromCompId: childComp.id, fromPinId: 'out', toCompId: gate.id, toPinId: 'in0', signal: 0 });
            return gate;
          }

          const leftComp = buildNode(node.left, depth - 1);
          const rightComp = buildNode(node.right, depth - 1);
          const gate = createComponent(node.type, gx, gy);
          state.components.push(gate);
          state.wires.push({ id: genId('w'), fromCompId: leftComp.id, fromPinId: 'out', toCompId: gate.id, toPinId: 'in0', signal: 0 });
          state.wires.push({ id: genId('w'), fromCompId: rightComp.id, fromPinId: 'out', toCompId: gate.id, toPinId: 'in1', signal: 0 });
          return gate;
        }

        function getDepth(n) {
          if (n.type === 'VAR') return 0;
          if (n.type === 'NOT') return 1 + getDepth(n.child);
          return 1 + Math.max(getDepth(n.left), getDepth(n.right));
        }

        const totalDepth = Math.max(1, getDepth(ast));
        const rootGate = buildNode(ast, totalDepth);
        const led = createComponent('LED', rootGate.x + 140, rootGate.y, { label: 'ƒ(x)', color: 'cyan', probe: true });
        state.components.push(led);
        state.wires.push({ id: genId('w'), fromCompId: rootGate.id, fromPinId: 'out', toCompId: led.id, toPinId: 'in0', signal: 0 });

        evaluateCircuitDeterministic(state.components, state.wires, 0);
        saveHistorySnapshot();
        centerAndFitView();
        updateInspector();
        showToast('Circuito sintetizado automáticamente');
      }

      let lastTruthTableCSV = '';
      function openTruthTableModal() {
        const inputs = state.components.filter(c => ['SWITCH', 'BUTTON', 'HIGH', 'LOW'].includes(c.type));
        const outputs = state.components.filter(c => ['LED', 'PROBE', 'BUZZER'].includes(c.type));

        const container = document.getElementById('tt-container');
        if (inputs.length === 0 || outputs.length === 0) {
          container.innerHTML = `<div style="padding:20px; text-align:center; color:var(--text-secondary);">Necesitas al menos una entrada (<span class="mono">SWITCH/BUTTON</span>) y una salida (<span class="mono">LED/PROBE</span>) en el lienzo.</div>`;
          document.getElementById('truth-table-modal').classList.remove('hidden');
          return;
        }

        const usedInputs = inputs.slice(0, 6);
        const rowsCount = 1 << usedInputs.length;

        // Guardar estado original para no alterar el circuito
        const backup = JSON.stringify({ components: state.components, wires: state.wires });

        const inHeaders = usedInputs.map((c, i) => c.label || `IN${i}`);
        const outHeaders = outputs.map((c, i) => c.label || `OUT${i}`);
        const csvRows = [[...inHeaders, ...outHeaders].join(',')];
        const tableRows = [];

        for (let r = 0; r < rowsCount; r++) {
          const inBits = [];
          usedInputs.forEach((inp, idx) => {
            const b = (r >> (usedInputs.length - 1 - idx)) & 1;
            inp.internalState.value = b;
            inBits.push(b);
          });
          evaluateCircuitDeterministic(state.components, state.wires, 0);
          const outBits = outputs.map(out => bit(out.pinValues.in0));
          csvRows.push([...inBits, ...outBits].join(','));
          tableRows.push({ inBits, outBits });
        }

        // Restaurar circuito intacto
        restoreSnapshot(backup);
        lastTruthTableCSV = csvRows.join('\n');

        let html = `<table class="tt-table"><thead><tr>`;
        inHeaders.forEach(h => { html += `<th>${h}</th>`; });
        outHeaders.forEach(h => { html += `<th style="color:var(--accent);">${h}</th>`; });
        html += `</tr></thead><tbody>`;

        tableRows.forEach((row, rIdx) => {
          html += `<tr data-ridx="${rIdx}" title="Clic para probar esta fila en el circuito">`;
          row.inBits.forEach(b => { html += `<td class="mono"><span class="bit-pill-${b}">${b}</span></td>`; });
          row.outBits.forEach(b => { html += `<td class="mono"><span class="bit-pill-${b}">${b}</span></td>`; });
          html += `</tr>`;
        });
        html += `</tbody></table>`;
        container.innerHTML = html;

        container.querySelectorAll('tbody tr').forEach(tr => {
          tr.onclick = () => {
            const row = tableRows[Number(tr.dataset.ridx)];
            usedInputs.forEach((inp, idx) => {
              inp.internalState.value = row.inBits[idx];
            });
            evaluateCircuitDeterministic(state.components, state.wires, 0);
            saveHistorySnapshot();
            soundFX.playClick(true);
            showToast('Combinación inyectada en el circuito');
          };
        });

        document.getElementById('truth-table-modal').classList.remove('hidden');
      }

