      }

      // =========================================================================
      // 15c. LOGICSCRIPT: lenguaje para construir circuitos con código (y con IA)
      // =========================================================================
      const LS_TYPE_ALIASES = { SW: 'SWITCH', BTN: 'BUTTON', CLK: 'CLOCK', DFF: 'D_FF', JKFF: 'JK_FF', TFF: 'T_FF', FF_D: 'D_FF', FF_T: 'T_FF', FF_JK: 'JK_FF', REG: 'REG_4', REGISTER: 'REG_4', COUNTER: 'COUNTER_4', CNT: 'COUNTER_4', RAM: 'RAM_16X4', ROM: 'ROM_16X4', ALU: 'ALU_4', MUX2: 'MUX_2', MUX4: 'MUX_4', DEMUX: 'DEMUX_2', HA: 'HALF_ADDER', FA: 'FULL_ADDER', SEG7: 'SEG7_DISPLAY', HEX: 'HEX_DISPLAY', TRISTATE: 'TRI_BUFFER', INV: 'NOT', ONE: 'HIGH', ZERO: 'LOW', VCC: 'HIGH', GND: 'LOW', TEXT: 'LABEL' };

      const LS_EXAMPLES = {
        'Sumador de 4 bits': `# Sumador de 4 bits con acarreo en cadena
for i in 0..3
  place a{i} = SWITCH label="A{i}"
  place b{i} = SWITCH label="B{i}"
  place fa{i} = FULL_ADDER
  place s{i} = LED label="S{i}" color=emerald
  connect a{i}.out -> fa{i}.a
  connect b{i}.out -> fa{i}.b
  connect fa{i}.s -> s{i}.in0
end
place cin = LOW
connect cin.out -> fa0.cin
for i in 0..2
  connect fa{i}.cout -> fa{i+1}.cin
end
place cout = LED label="COUT" color=rose
connect fa3.cout -> cout.in0`,
        'Mini-CPU acumulador (PC + ROM + ALU + ACC)': `# Mini-CPU de 4 bits: cada pulso de reloj suma/opera con el siguiente dato del programa
# PC (contador) -> direccion de la ROM -> dato a la ALU (entrada B)
# ACC (registro) -> ALU (entrada A); resultado de la ALU -> ACC
place clk = CLOCK hz=1 label="CLK"
place rst = SWITCH label="RST"
place en = HIGH
place cin = LOW
place pc = COUNTER_4 label="PC"
place rom = ROM_16X4 label="PROGRAMA" mem=1231231231231231
place alu = ALU_4 label="ALU"
place acc = REG_4 label="ACC"
place disp = HEX_DISPLAY label="ACC"
place op0 = SWITCH label="OP0"
place op1 = SWITCH label="OP1"
place op2 = SWITCH label="OP2"
connect clk.out -> pc.clk, acc.clk
connect en.out -> pc.en
connect rst.out -> pc.rst, acc.rst
connect cin.out -> alu.cin
connect op0.out -> alu.s0
connect op1.out -> alu.s1
connect op2.out -> alu.s2
for i in 0..3
  connect pc.q{i} -> rom.a{i}
  connect rom.q{i} -> alu.b{i}
  connect acc.q{i} -> alu.a{i}
  connect alu.y{i} -> acc.d{i}
  connect acc.q{i} -> disp.d{i}
end`,
        'Contador con display': `# Reloj -> contador de 4 bits -> display hexadecimal
place clk = CLOCK hz=2 label="CLK"
place en = HIGH
place rst = SWITCH label="RST"
place cnt = COUNTER_4
place disp = HEX_DISPLAY
connect clk.out -> cnt.clk
connect en.out -> cnt.en
connect rst.out -> cnt.rst
for i in 0..3
  connect cnt.q{i} -> disp.d{i}
end`,
        'Máquina de estados (ciclo de 4)': `# FSM de 4 estados que avanza S0 -> S1 -> S2 -> S3 -> S0 con cada pulso
place clk = CLOCK hz=1 label="CLK"
place x = HIGH
place rst = SWITCH label="RST"
place m = FSM fsm=4;1,2,3,0;1,2,3,0;0,0,0,1
place l1 = LED label="Q1" color=amber
place l0 = LED label="Q0" color=amber
place z = LED label="Z" color=rose
connect clk.out -> m.clk
connect x.out -> m.x
connect rst.out -> m.rst
connect m.q1 -> l1.in0
connect m.q0 -> l0.in0
connect m.z -> z.in0`
      };

      function lsSubst(t, env) {
        return t.replace(/\{\s*([A-Za-z_]\w*)\s*(?:([+\-*])\s*(\d+))?\s*\}/g, (m, v, op, k) => {
          if (!(v in env)) return m;
          const x = env[v], n = Number(k);
          return String(op === '+' ? x + n : op === '-' ? x - n : op === '*' ? x * n : x);
        });
      }

      function lsExpandBlock(items, env, out, errors) {
        for (let i = 0; i < items.length; i++) {
          const n = items[i].n;
          const t = lsSubst(items[i].t, env);
          const m = t.match(/^for\s+([A-Za-z_]\w*)\s+in\s+(-?\d+)\s*\.\.\s*(-?\d+)\s*$/i);
          if (m) {
            let depth = 1, j = i + 1;
            for (; j < items.length; j++) {
              if (/^for\s/i.test(items[j].t)) depth++;
              else if (/^end$/i.test(items[j].t)) { depth--; if (!depth) break; }
            }
            if (j >= items.length) { errors.push({ line: n, msg: 'Falta "end" para cerrar este "for"' }); return; }
            const a = Number(m[2]), b = Number(m[3]);
            if (Math.abs(b - a) > 255) { errors.push({ line: n, msg: 'Un "for" no puede tener más de 256 vueltas' }); i = j; continue; }
            const body = items.slice(i + 1, j), step = a <= b ? 1 : -1;
            for (let v = a; step > 0 ? v <= b : v >= b; v += step) lsExpandBlock(body, { ...env, [m[1]]: v }, out, errors);
            i = j;
            continue;
          }
          if (/^end$/i.test(t)) { errors.push({ line: n, msg: '"end" sin "for" que lo abra' }); continue; }
          out.push({ t, n });
        }
      }

      function lsParseLine(t, n, errors) {
        const mp = t.match(/^place\s+([A-Za-z_]\w*)\s*=\s*([A-Za-z0-9_]+)\s*(.*)$/i);
        if (mp) {
          let rest = mp[3], at = null;
          const masked = rest.replace(/"[^"]*"/g, q => '_'.repeat(q.length));
          const ma = masked.match(/\bat\s+(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)/i);
          if (ma) { at = { x: Number(ma[1]), y: Number(ma[2]) }; rest = rest.slice(0, ma.index) + ' '.repeat(ma[0].length) + rest.slice(ma.index + ma[0].length); }
          const opts = {}, re = /([A-Za-z_]\w*)\s*=\s*("([^"]*)"|[^\s"]+)/g;
          let mo;
          while ((mo = re.exec(rest))) opts[mo[1].toLowerCase()] = mo[3] !== undefined ? mo[3] : mo[2];
          const leftover = rest.replace(re, '').trim();
          if (leftover) errors.push({ line: n, msg: `Texto no reconocido: "${leftover}" (las opciones son clave=valor)` });
          return { kind: 'place', alias: mp[1], type: mp[2].toUpperCase(), opts, at, line: n };
        }
        const mc = t.match(/^connect\s+(.+?)\s*->\s*(.+)$/i);
        if (mc) {
          const ref = s => { const m = s.trim().match(/^([A-Za-z_]\w*)\.([A-Za-z0-9_]+)$/); return m ? { alias: m[1], pin: m[2] } : null; };
          const from = ref(mc[1]), tos = mc[2].split(',').map(ref);
          if (!from || tos.some(x => !x)) { errors.push({ line: n, msg: 'Conexión inválida. Formato: connect origen.pin -> destino.pin, otro.pin' }); return null; }
          return { kind: 'connect', from, tos, line: n };
        }
        errors.push({ line: n, msg: `Instrucción no reconocida: "${t.slice(0, 48)}". Usa place / connect / for…end` });
        return null;
      }

      function lsLayout(auto, wires, ox, oy) {
        const idx = new Map(auto.map((c, i) => [c.id, i]));
        const N = auto.length, succ = auto.map(() => []), rawIn = new Array(N).fill(0);
        wires.forEach(w => {
          const a = idx.get(w.fromCompId), b = idx.get(w.toCompId);
          if (a === undefined || b === undefined || a === b) return;
          succ[a].push(b); rawIn[b]++;
        });
        const color = new Array(N).fill(0), dag = auto.map(() => new Set());
        const dfs = u => { color[u] = 1; for (const v of succ[u]) { if (color[v] === 1) continue; dag[u].add(v); if (color[v] === 0) dfs(v); } color[u] = 2; };
        for (let i = 0; i < N; i++) if (rawIn[i] === 0 && color[i] === 0) dfs(i);
        for (let i = 0; i < N; i++) if (color[i] === 0) dfs(i);
        const indeg = new Array(N).fill(0);
        dag.forEach(s => s.forEach(v => indeg[v]++));
        const depth = new Array(N).fill(0), q = [];
        indeg.forEach((d, i) => { if (d === 0) q.push(i); });
        while (q.length) { const u = q.shift(); dag[u].forEach(v => { depth[v] = Math.max(depth[v], depth[u] + 1); if (--indeg[v] === 0) q.push(v); }); }
        for (let i = 0; i < N; i++) if (rawIn[i] === 0 && dag[i].size) depth[i] = Math.max(0, Math.min(...[...dag[i]].map(v => depth[v])) - 1);
        const maxD = Math.max(0, ...depth);
        const cols = Array.from({ length: maxD + 1 }, () => []);
        depth.forEach((d, i) => cols[d].push(i));
        const pos = new Array(N).fill(0);
        const refresh = () => cols.forEach(col => col.forEach((u, r) => { pos[u] = r; }));
        refresh();
        const pred = auto.map(() => []);
        dag.forEach((s, u) => s.forEach(v => pred[v].push(u)));
        for (let pass = 0; pass < 2; pass++) {
          cols.forEach(col => { col.sort((a, b) => bary(pred[a], a) - bary(pred[b], b)); }); refresh();
          for (let d = cols.length - 1; d >= 0; d--) { cols[d].sort((a, b) => bary([...dag[a]], a) - bary([...dag[b]], b)); } refresh();
        }
        function bary(list, self) { return list.length ? list.reduce((s, x) => s + pos[x], 0) / list.length : pos[self]; }
        let x = 0;
        const GAPX = 130, GAPY = 30;
        cols.forEach(col => {
          if (!col.length) return;
          const cw = Math.max(...col.map(u => auto[u].w));
          const total = col.reduce((s, u) => s + auto[u].h + GAPY, -GAPY);
          let y = -total / 2;
          col.forEach(u => { const c = auto[u]; c.x = Math.round((x + cw / 2 + ox) / 10) * 10; c.y = Math.round((y + c.h / 2 + oy) / 10) * 10; y += c.h + GAPY; });
          x += cw + GAPX;
        });
      }

      function lsBuild(src, replace) {
        const errors = [], warnings = [], items = [];
        src.split(/\r?\n/).forEach((raw, i) => {
          const t = raw.replace(/\s+(#|\/\/).*$/, m => (m.includes('"') ? m : '')).trim();
          if (!t || t.startsWith('#') || t.startsWith('//')) return;
          items.push({ t, n: i + 1 });
        });
        const flat = [];
        lsExpandBlock(items, {}, flat, errors);
        const places = [], conns = [];
        flat.forEach(({ t, n }) => {
          const left = t.match(/\{[^}]*\}/);
          if (left && !/"[^"]*\{/.test(t)) { errors.push({ line: n, msg: `Variable sin definir: ${left[0]} (solo existen dentro de su "for")` }); return; }
          const r = lsParseLine(t, n, errors);
          if (r) (r.kind === 'place' ? places : conns).push(r);
        });
        const validTypes = COMPONENT_CATALOG.filter(m => m.type !== 'CUSTOM_IC').map(m => m.type);
        const byAlias = new Map(), comps = [];
        for (const p of places) {
          if (byAlias.has(p.alias)) { errors.push({ line: p.line, msg: `Alias repetido: "${p.alias}"` }); continue; }
          const type = LS_TYPE_ALIASES[p.type] || p.type;
          if (!validTypes.includes(type)) { errors.push({ line: p.line, msg: `Tipo desconocido "${p.type}". Válidos: ${validTypes.join(', ')}` }); continue; }
          const o = p.opts, co = {};
          let bad = false;
          const fail = msg => { errors.push({ line: p.line, msg }); bad = true; };
          if (o.label !== undefined) co.label = o.label;
          if (o.text !== undefined) co.noteText = o.text;
          if (o.color) { const k = o.color.toLowerCase(); if (!LED_PALETTE[k]) fail(`Color "${o.color}" no válido (${Object.keys(LED_PALETTE).join(', ')})`); else co.color = k; }
          if (o.inputs) { const k = parseInt(o.inputs, 10); if (!(k >= 2 && k <= 4)) fail('inputs debe ser 2, 3 o 4'); else co.inputCount = k; }
          if (o.hz) { const k = parseFloat(o.hz); if (!(k > 0 && k <= 50)) fail('hz debe estar entre 0 y 50'); else co.freqHz = k; }
          if (o.value !== undefined) { if (type === 'HEX_KEY') co.hexVal = parseInt(o.value, 16) & 15; else co.initialValue = o.value === '1' ? 1 : 0; }
          if (o.seq) { if (!/^[01]{1,8}$/.test(o.seq)) fail('seq debe ser de 1 a 8 bits (ej. 10110010)'); else co.seqBits = o.seq.split('').map(Number); }
          if (o.probe) co.probe = o.probe === '1' || o.probe === 'true';
          let mem = null, fsm = null;
          if (o.mem !== undefined) {
            if (type !== 'RAM_16X4' && type !== 'ROM_16X4') fail('mem solo existe en RAM_16X4 y ROM_16X4');
            else { const hex = o.mem.replace(/[^0-9a-fA-F]/g, ''); mem = Array.from({ length: 16 }, (_, i) => parseInt(hex[i] || '0', 16) & 15); }
          }
          if (o.fsm !== undefined) {
            if (type !== 'FSM') fail('fsm solo existe en el tipo FSM');
            else {
              const parts = o.fsm.split(';'), n = parseInt(parts[0], 10);
              const arr = k => (parts[k] || '').split(',').map(v => parseInt(v, 10));
              const n0 = arr(1), n1 = arr(2), ou = arr(3);
              if (!(n >= 2 && n <= 8) || [n0, n1, ou].some(a => a.length !== n || a.some(v => isNaN(v))) || n0.concat(n1).some(v => v < 0 || v >= n)) fail('fsm debe ser N;next0;next1;out con N de 2 a 8 y N valores válidos en cada lista. Ej: fsm=4;0,2,0,2;1,1,3,1;0,0,0,1');
              else fsm = { n, next0: n0, next1: n1, out: ou.map(v => (v ? 1 : 0)) };
            }
          }
          if (bad) continue;
          const comp = createComponent(type, p.at ? p.at.x : 0, p.at ? p.at.y : 0, co);
          if (mem) comp.internalState.mem = mem;
          if (fsm) comp.internalState.fsm = fsm;
          if (o.rot) comp.rot = ((parseInt(o.rot, 10) || 0) % 4 + 4) % 4;
          if (o.flip === '1' || o.flip === 'true') comp.flip = true;
          comp._fixed = Boolean(p.at);
          byAlias.set(p.alias, comp);
          comps.push(comp);
        }
        const newWires = [], seen = new Set(), driven = new Map();
        const pinOf = (alias, pin, line) => {
          const comp = byAlias.get(alias);
          if (!comp) { errors.push({ line, msg: `Alias desconocido: "${alias}" (decláralo antes con place)` }); return null; }
          const p = comp.pins.find(q => q.id.toLowerCase() === pin.toLowerCase());
          if (!p) { errors.push({ line, msg: `"${alias}" (${comp.type}) no tiene el pin "${pin}". Pines: ${comp.pins.map(q => q.id).join(', ')}` }); return null; }
          return { comp, p };
        };
        for (const c of conns) {
          const A = pinOf(c.from.alias, c.from.pin, c.line);
          for (const to of c.tos) {
            const B = pinOf(to.alias, to.pin, c.line);
            if (!A || !B) continue;
            let f = A, t = B;
            if (f.p.dir === 'in' && t.p.dir === 'out') { f = B; t = A; }
            if (f.p.dir !== 'out' || t.p.dir !== 'in') { errors.push({ line: c.line, msg: `Un cable une una salida con una entrada: ${c.from.alias}.${c.from.pin} -> ${to.alias}.${to.pin}` }); continue; }
            const key = `${f.comp.id}.${f.p.id}>${t.comp.id}.${t.p.id}`;
            if (seen.has(key)) continue;
            seen.add(key);
            const dk = `${t.comp.id}.${t.p.id}`;
            if (driven.has(dk) && f.comp.type !== 'TRI_BUFFER' && driven.get(dk).type !== 'TRI_BUFFER') warnings.push(`Línea ${c.line}: el pin ${to.alias}.${to.pin} recibe más de un cable (se pisarán entre sí)`);
            driven.set(dk, f.comp);
            newWires.push({ id: genId('w'), fromCompId: f.comp.id, fromPinId: f.p.id, toCompId: t.comp.id, toPinId: t.p.id, signal: 0 });
          }
        }
        if (errors.length) return { errors, warnings };
        if (!comps.length) return { errors: [{ line: 1, msg: 'El script no crea ningún componente (usa "place alias = TIPO")' }], warnings };

        const auto = comps.filter(c => !c._fixed);
        let ox = 0, oy = 0;
        if (!replace && state.components.length) ox = Math.max(...state.components.map(c => c.x + c.w / 2)) + 160;
        if (auto.length) lsLayout(auto, newWires, ox, oy);
        comps.forEach(c => { delete c._fixed; });
        if (replace) { state.components = []; state.wires = []; }
        state.components.push(...comps);
        state.wires.push(...newWires);
        state.selectedIds = new Set();
        state.selectedWireId = null;
        for (let k = 0; k < 3; k++) evaluateCircuitDeterministic(state.components, state.wires, 0);
        saveHistorySnapshot();
        updateInspector();
        updateStatusBar();
        centerAndFitView();
        soundFX.playPop(820);
        return { errors: [], warnings, comps: comps.length, wires: newWires.length };
      }

      function lsExport() {
        const used = new Set(), alias = new Map();
        state.components.forEach(c => {
          if (c.type === 'CUSTOM_IC') return;
          let base = (c.label || '').replace(/[^A-Za-z0-9_]/g, '_').replace(/_+/g, '_').replace(/^_|_$/g, '') || c.type.toLowerCase();
          if (!/^[A-Za-z_]/.test(base)) base = 'c_' + base;
          let a = base, k = 1;
          while (used.has(a.toLowerCase())) a = base + '_' + (++k);
          used.add(a.toLowerCase());
          alias.set(c.id, a);
        });
        const lines = ['# LogicScript exportado desde LogicStudio Pro', ''];
        const colorTypes = ['LED', 'SEG7_DISPLAY', 'SEG7_MULTI', 'HEX_DISPLAY', 'LED_BAR_4'];
        state.components.forEach(c => {
          if (c.type === 'CUSTOM_IC') { lines.push(`# (IC personalizado "${c.label || 'IC'}" no se puede exportar)`); return; }
          const meta = COMPONENT_CATALOG.find(m => m.type === c.type) || {};
          const q = s => `"${String(s).replace(/"/g, "'")}"`;
          const parts = [];
          if (c.label) parts.push(`label=${q(c.label)}`);
          if (c.type === 'LABEL') parts.push(`text=${q(c.noteText || '')}`);
          if (colorTypes.includes(c.type) && c.color && c.color !== 'cyan') parts.push(`color=${c.color}`);
          if (meta.variableInputs && c.inputCount !== 2) parts.push(`inputs=${c.inputCount}`);
          if (c.type === 'CLOCK' && c.freqHz !== null && c.freqHz !== undefined) parts.push(`hz=${c.freqHz}`);
          if (c.type === 'SWITCH' && c.internalState.value === 1) parts.push('value=1');
          if (c.type === 'HEX_KEY') parts.push(`value=${(c.internalState.hexVal || 0).toString(16).toUpperCase()}`);
          if (c.type === 'PULSE_GEN') parts.push(`seq=${(c.internalState.seqBits || []).join('')}`);
          if ((c.type === 'RAM_16X4' || c.type === 'ROM_16X4') && c.internalState.mem) parts.push(`mem=${c.internalState.mem.map(v => (v & 15).toString(16).toUpperCase()).join('')}`);
          if (c.type === 'FSM' && c.internalState.fsm) { const f = c.internalState.fsm; parts.push(`fsm=${f.n};${f.next0.join(',')};${f.next1.join(',')};${f.out.join(',')}`); }
          if (c.rot) parts.push(`rot=${c.rot}`);
          if (c.flip) parts.push('flip=1');
          if (c.probe) parts.push('probe=1');
          lines.push(`place ${alias.get(c.id)} = ${c.type}${parts.length ? ' ' + parts.join(' ') : ''} at ${c.x},${c.y}`);
        });
        lines.push('');
        const groups = new Map();
        state.wires.forEach(w => {
          if (!alias.has(w.fromCompId) || !alias.has(w.toCompId)) return;
          const k = `${w.fromCompId}|${w.fromPinId}`;
          if (!groups.has(k)) groups.set(k, { from: `${alias.get(w.fromCompId)}.${w.fromPinId}`, to: [] });
          groups.get(k).to.push(`${alias.get(w.toCompId)}.${w.toPinId}`);
        });
        groups.forEach(g => lines.push(`connect ${g.from} -> ${g.to.join(', ')}`));
        return lines.join('\n');
      }

