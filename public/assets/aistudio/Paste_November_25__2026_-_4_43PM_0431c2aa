      // =========================================================================
      // 16. BUCLE DE ANIMACIÓN A 60 FPS (FÍSICA ELÁSTICA + SIMULACIÓN)
      // =========================================================================
      function updateVisualAnimations(dt) {
        for (const c of state.components) {
          if (c.spawnScale !== undefined && (c.spawnScale !== 1 || Math.abs(c.spawnVel || 0) > 0.01)) {
            const force = (1 - c.spawnScale) * 200;
            c.spawnVel = ((c.spawnVel || 0) + force * dt) * Math.exp(-15 * dt);
            c.spawnScale += c.spawnVel * dt;
            if (Math.abs(1 - c.spawnScale) < 0.004 && Math.abs(c.spawnVel) < 0.02) {
              c.spawnScale = 1;
              c.spawnVel = 0;
            }
          }
        }

        if (state.view.targetX !== null) {
          const ease = 1 - Math.exp(-12 * dt);
          state.view.x += (state.view.targetX - state.view.x) * ease;
          state.view.y += (state.view.targetY - state.view.y) * ease;
          state.view.zoom += (state.view.targetZoom - state.view.zoom) * ease;
          document.getElementById('zoom-readout').textContent = `${Math.round(state.view.zoom * 100)}%`;
          if (Math.hypot(state.view.targetX - state.view.x, state.view.targetY - state.view.y) < 0.6) {
            state.view.x = state.view.targetX;
            state.view.y = state.view.targetY;
            state.view.zoom = state.view.targetZoom;
            state.view.targetX = null;
          }
        }

        for (let i = state.ripples.length - 1; i >= 0; i--) {
          const r = state.ripples[i];
          r.r += (r.maxR - r.r) * Math.min(1, dt * 8);
          r.alpha -= dt * 1.9;
          if (r.alpha <= 0) state.ripples.splice(i, 1);
        }

        for (let i = state.sparks.length - 1; i >= 0; i--) {
          const s = state.sparks[i];
          s.x += s.vx * dt;
          s.y += s.vy * dt;
          s.life -= dt;
          if (s.life <= 0) state.sparks.splice(i, 1);
        }
      }

      let lastFrameTime = performance.now();
      let frameN = 0;
      function mainLoop(now) {
        const rawDt = now - lastFrameTime;
        const dt = Math.min(0.05, Math.max(0.001, rawDt / 1000));
        lastFrameTime = now;
        frameN++;
        FX.ema += (Math.min(rawDt, 120) - FX.ema) * 0.08;
        if (SETTINGS.quality === 'auto' && now > FX.checkAt) {
          FX.checkAt = now + 1000;
          if (!FX.degraded && FX.ema > 26 && state.components.length > 0) { FX.degraded = true; FX.retest = now + 25000; }
          else if (FX.degraded && now > FX.retest) { FX.degraded = false; FX.retest = Infinity; }
        }
        FX.halfRate = SETTINGS.quality !== 'high' && (SETTINGS.quality === 'low' ? FX.ema > 30 : FX.degraded && FX.ema > 30);

        stepSimulation(dt, false);
        const animating = state.simRunning || state.ripples.length > 0 || state.sparks.length > 0 || state.view.targetX !== null ||
          now < RS.until || state.components.some(c => c.spawnScale !== undefined && c.spawnScale !== 1);
        updateVisualAnimations(dt);
        const wasDirty = RS.dirty;
        if ((RS.dirty || animating) && !(FX.halfRate && (frameN & 1))) { renderMainCanvas(); RS.dirty = false; }
        if (state.analyzerDirty || wasDirty) { renderAnalyzerCanvas(); state.analyzerDirty = false; }

        requestAnimationFrame(mainLoop);
      }

      // =========================================================================
      // 17. ARRANQUE DE LA APLICACIÓN
      // =========================================================================
      ['pointerdown', 'pointermove', 'pointerup', 'wheel', 'keydown', 'keyup', 'click', 'dblclick', 'change', 'input', 'contextmenu', 'drop', 'dragover', 'touchstart'].forEach(ev => document.addEventListener(ev, () => markDirty(300), { capture: true, passive: true }));
      window.addEventListener('resize', () => markDirty(300));
      document.addEventListener('visibilitychange', () => markDirty(300));
      renderComponentLibrary();
      initEvents();
      document.getElementById('btn-lib-expand').onclick = () => { state.collapsedCats.clear(); state.animCat = null; renderComponentLibrary(); };
      document.getElementById('btn-lib-collapse').onclick = () => { CATEGORIES.forEach(c => state.collapsedCats.add(c)); renderComponentLibrary(); };
      document.getElementById('btn-lib-hide').onclick = () => { setLibraryHidden(true); savePrefs(); };
      document.getElementById('btn-lib-show').onclick = () => { setLibraryHidden(false); savePrefs(); };
      document.getElementById('component-search').addEventListener('keydown', (e) => {
        if (e.key === 'Escape') { e.target.value = ''; renderComponentLibrary(); e.target.blur(); }
      });

      try {
        const prefs = JSON.parse(localStorage.getItem(PREFS_KEY) || 'null');
        if (prefs) {
          if (['cyber', 'blueprint', 'clean'].includes(prefs.theme)) {
            state.theme = prefs.theme;
            document.documentElement.setAttribute('data-theme', prefs.theme);
            document.getElementById('theme-selector').value = prefs.theme;
          }
          if (prefs.wireStyle === 'orthogonal') document.getElementById('btn-wire-style').click();
          if (prefs.sound === false) document.getElementById('btn-sound-toggle').click();
          if (prefs.libHidden) setLibraryHidden(true);
          if (prefs.settings) Object.assign(SETTINGS, prefs.settings);
          if (prefs.hz) {
            const hz = document.getElementById('global-clock-hz');
            hz.value = prefs.hz;
            hz.dispatchEvent(new Event('input'));
          }
        }
      } catch (_) {}

      loadPresetCircuit('demo');
      try {
        const saved = localStorage.getItem(AUTOSAVE_KEY);
        const parsed = saved ? JSON.parse(saved) : null;
        if (parsed && Array.isArray(parsed.components) && parsed.components.length > 0) {
          state.history = [];
          state.historyIndex = -1;
          restoreSnapshot(saved);
          saveHistorySnapshot();
          centerAndFitView();
          showToast('Sesión anterior restaurada');
        }
      } catch (_) {}
      requestAnimationFrame(mainLoop);
    });
  </script>
</body>
