          const disp = add('SEG7_DISPLAY', 140, 0, { label: 'Display 7-Seg', color: 'cyan' });

          ['d3', 'd2', 'd1', 'd0'].forEach((dPin, i) => {
            link(keypad, `b${3 - i}`, dec, dPin);
          });
          ['a', 'b', 'c', 'd', 'e', 'f', 'g'].forEach(seg => {
            link(dec, seg, disp, seg);
          });
        } else if (key === 'comp_2bit') {
          const a1 = add('SWITCH', -230, -95, { label: 'A1', initialValue: 1 });
          const a0 = add('SWITCH', -230, -35, { label: 'A0', initialValue: 0 });
          const b1 = add('SWITCH', -230, 35, { label: 'B1', initialValue: 0 });
          const b0 = add('SWITCH', -230, 95, { label: 'B0', initialValue: 1 });
          const cmp = add('COMP_2', -40, 0, { label: 'Comparador' });
          const lGt = add('LED', 130, -60, { label: 'A > B', color: 'emerald' });
          const lEq = add('LED', 130, 0, { label: 'A = B', color: 'cyan' });
          const lLt = add('LED', 130, 60, { label: 'A < B', color: 'amber' });

          link(a1, 'out', cmp, 'a1');
          link(a0, 'out', cmp, 'a0');
          link(b1, 'out', cmp, 'b1');
          link(b0, 'out', cmp, 'b0');
          link(cmp, 'gt', lGt, 'in0');
          link(cmp, 'eq', lEq, 'in0');
          link(cmp, 'lt', lLt, 'in0');
        } else if (key === 'ring_osc') {
          add('LABEL', 0, -130, { noteText: 'Oscilador en Anillo (Ciclo de Realimentación Impar)' });
          const n1 = add('NOT', -140, 0, { label: 'INV 1', probe: true });
          const n2 = add('NOT', 0, 0, { label: 'INV 2', probe: true });
          const n3 = add('NOT', 140, 0, { label: 'INV 3', probe: true });
          link(n1, 'out', n2, 'in0');
          link(n2, 'out', n3, 'in0');
          link(n3, 'out', n1, 'in0');
        }

        evaluateCircuitDeterministic(state.components, state.wires, 0);
        saveHistorySnapshot();
        centerAndFitView();
        updateInspector();
      }

      // =========================================================================
      // 14. MENÚ CONTEXTUAL, EDICIÓN INLINE Y PALETA DE COMANDOS (CTRL+K)
      // =========================================================================
      function openInlineEditor(comp) {
        const input = document.getElementById('inline-edit-input');
        const rect = mainCanvas.getBoundingClientRect();
        const scr = worldToScreen(comp.x, comp.y);
        state.inlineEditCompId = comp.id;
        input.value = comp.type === 'LABEL' ? (comp.noteText || '') : (comp.label || '');
        input.style.left = `${Math.max(10, Math.min(window.innerWidth - 180, rect.left + scr.x - 75))}px`;
        input.style.top = `${Math.max(54, Math.min(window.innerHeight - 44, rect.top + scr.y - 16))}px`;
        input.classList.remove('hidden');
        input.focus();
        input.select();
      }

      function commitInlineEditor(save = true) {
        const input = document.getElementById('inline-edit-input');
        if (input.classList.contains('hidden')) return;
        if (save && state.inlineEditCompId) {
          const comp = state.components.find(c => c.id === state.inlineEditCompId);
          if (comp) {
            if (comp.type === 'LABEL') comp.noteText = input.value.trim() || 'Nota';
            else comp.label = input.value.trim();
            saveHistorySnapshot();
            updateInspector();
          }
        }
        state.inlineEditCompId = null;
        input.classList.add('hidden');
      }

      function hideContextMenu() {
        document.getElementById('context-menu').classList.add('hidden');
      }

      function showContextMenu(sx, sy, wPos) {
        const menu = document.getElementById('context-menu');
        const compHit = hitTestComponent(wPos);
        const wireHit = compHit ? null : hitTestWire(wPos, 9 / state.view.zoom);
        const items = [];

        if (compHit) {
          if (!state.selectedIds.has(compHit.id)) {
            state.selectedIds = new Set([compHit.id]);
            state.selectedWireId = null;
            updateInspector();
          }
          items.push({ label: 'Editar etiqueta / texto', action: () => openInlineEditor(compHit) });
          items.push({ label: 'Duplicar selección (Ctrl+D)', action: duplicateSelection });
          if (compHit.type !== 'LABEL') {
            items.push({ label: 'Rotar 90° (R)', action: () => rotateSelection(1) });
            items.push({ label: 'Voltear (H)', action: flipSelection });
            items.push({
              label: compHit.probe ? 'Quitar del Osciloscopio' : 'Enviar al Osciloscopio',
              action: () => { compHit.probe = !compHit.probe; saveHistorySnapshot(); updateInspector(); }
            });
          }
          items.push({ label: 'Eliminar (Supr)', danger: true, action: deleteSelection });
        } else if (wireHit) {
          state.selectedIds.clear();
          state.selectedWireId = wireHit.id;
          updateInspector();
          items.push({ label: 'Cambiar estilo Bézier / Ortogonal', action: () => document.getElementById('btn-wire-style').click() });
          items.push({ label: 'Eliminar conductor (Supr)', danger: true, action: deleteSelection });
        } else {
          items.push({ label: 'Centrar y ajustar vista (F)', action: centerAndFitView });
          items.push({ label: 'Sintetizador Booleano ƒ(x)', action: () => document.getElementById('bool-synth-modal').classList.remove('hidden') });
          items.push({ label: 'Generar Tabla de Verdad', action: openTruthTableModal });
        }

        menu.innerHTML = items.map((it, idx) => `
          <button data-idx="${idx}" class="context-item ${it.danger ? 'danger' : ''}">${it.label}</button>
        `).join('');
        menu.classList.remove('hidden');
        const mh = menu.offsetHeight || 160, mw = menu.offsetWidth || 220;
        menu.style.left = `${Math.max(6, Math.min(window.innerWidth - mw - 8, sx))}px`;
        menu.style.top = `${Math.max(6, Math.min(window.innerHeight - mh - 8, sy))}px`;

        menu.querySelectorAll('.context-item').forEach(btn => {
          btn.onclick = () => {
            hideContextMenu();
            items[Number(btn.dataset.idx)].action();
          };
        });
      }

      function openCommandPalette() {
        const modal = document.getElementById('cmd-palette-modal');
        const input = document.getElementById('cmd-palette-input');
        modal.classList.remove('hidden');
        input.value = '';
        renderCommandPaletteList('');
        input.focus();
      }

      function renderCommandPaletteList(q) {
        const list = document.getElementById('cmd-palette-list');
        const query = q.trim().toLowerCase();
        const entries = [
          { tag: 'ACCIÓN', label: 'Sintetizador Booleano ƒ(x)', run: () => document.getElementById('bool-synth-modal').classList.remove('hidden') },
          { tag: 'ACCIÓN', label: 'Generar Tabla de Verdad Automática', run: openTruthTableModal },
          { tag: 'ACCIÓN', label: 'Empaquetar Circuito como Chip IC', run: openCustomICModal },
          { tag: 'ACCIÓN', label: 'Centrar y Ajustar Vista (F)', run: centerAndFitView },
          { tag: 'ACCIÓN', label: 'Exportar Captura PNG', run: () => document.getElementById('btn-export-png').click() },
          { tag: 'ACCIÓN', label: 'Abrir editor LogicScript (código + prompt IA)', run: () => document.getElementById('btn-script').click() },
          { tag: 'ACCIÓN', label: 'Abrir Modo Ejercicios (Retos)', run: () => document.getElementById('btn-challenges').click() },
          { tag: 'ACCIÓN', label: 'Ordenar circuito automáticamente (O)', run: () => autoTidy() },
          { tag: 'ACCIÓN', label: 'Ajustes (calidad, doble clic, cuadrícula…)', run: () => document.getElementById('btn-settings').click() },
          { tag: 'ACCIÓN', label: 'Atajos de teclado (?)', run: () => document.getElementById('btn-shortcuts').click() },
          { tag: 'ACCIÓN', label: 'Rotar selección (R)', run: () => rotateSelection(1) },
          { tag: 'ACCIÓN', label: 'Voltear selección (H)', run: flipSelection },
          ...COMPONENT_CATALOG.map(c => ({
            tag: 'COMPONENTE',
            label: `Añadir ${c.name} (${c.badge})`,
            run: () => {
              const wrap = document.getElementById('canvas-wrapper').getBoundingClientRect();
              const cw = screenToWorld(wrap.width / 2, wrap.height / 2);
              addComponentToCanvas(c.type, cw.x, cw.y);
            }
          }))
        ].filter(e => !query || e.label.toLowerCase().includes(query) || e.tag.toLowerCase().includes(query));

        list.innerHTML = entries.slice(0, 14).map((e, idx) => `
          <button data-idx="${idx}" class="context-item">
            <span>${e.label}</span>
            <span class="beta-badge">${e.tag}</span>
          </button>
        `).join('');

        list.querySelectorAll('button').forEach(btn => {
          btn.onclick = () => {
            document.getElementById('cmd-palette-modal').classList.add('hidden');
            entries[Number(btn.dataset.idx)].run();
          };
        });
      }

      // =========================================================================
      // 15. INICIALIZACIÓN DE EVENTOS DE RATÓN, TECLADO Y CONTROLES
      // =========================================================================
      function loadJsonFile(file) {
        const reader = new FileReader();
        reader.onload = (ev) => {
          try {
            const parsed = JSON.parse(ev.target.result);
            if (!Array.isArray(parsed.components)) throw new Error('Formato inválido');
            if (!Array.isArray(parsed.wires)) parsed.wires = [];
            restoreSnapshot(JSON.stringify(parsed));
            saveHistorySnapshot();
            centerAndFitView();
            showToast('Circuito JSON cargado');
          } catch (_) {
            showToast('No se pudo leer el archivo JSON', 'warn');
          }
        };
        reader.onerror = () => showToast('Error leyendo el archivo', 'warn');
        reader.readAsText(file);
      }

      function initEvents() {
        // Búsqueda en biblioteca
        document.getElementById('component-search').addEventListener('input', renderComponentLibrary);

        // Soltar componente arrastrado desde biblioteca
        const canvasWrap = document.getElementById('canvas-wrapper');
        canvasWrap.addEventListener('dragover', (e) => e.preventDefault());
        canvasWrap.addEventListener('drop', (e) => {
          e.preventDefault();
          const dropped = e.dataTransfer.files && e.dataTransfer.files[0];
          if (dropped && /\.json$/i.test(dropped.name)) { loadJsonFile(dropped); return; }
          const raw = e.dataTransfer.getData('application/json');
          if (!raw) return;
          let data;
          try { data = JSON.parse(raw); } catch (_) { return; }
          if (!data || !data.type) return;
          const rect = mainCanvas.getBoundingClientRect();
          const wPos = screenToWorld(e.clientX - rect.left, e.clientY - rect.top);
          addComponentToCanvas(data.type, wPos.x, wPos.y, { icDefId: data.icDefId || null });
        });

        // Interacción en Lienzo Principal
        mainCanvas.addEventListener('pointerdown', (e) => {
          hideContextMenu();
          commitInlineEditor(true);

          const rect = mainCanvas.getBoundingClientRect();
          const sx = e.clientX - rect.left;
          const sy = e.clientY - rect.top;
          const wPos = screenToWorld(sx, sy);

          state.view.targetX = null;
          state.dragStartScreen = { x: sx, y: sy };
          state.dragStartWorld = { x: wPos.x, y: wPos.y };

          if (e.button === 1 || state.spacePressed) {
            state.mode = 'PANNING';
            if (state.spacePressed) state.spaceDidPan = true;
            mainCanvas.style.cursor = 'grabbing';
            return;
          }

          if (e.button !== 0) return;

          // 1. ¿Clic en pin? -> Iniciar cableado
          const pinHit = hitTestPin(wPos, 13 / state.view.zoom);
          if (pinHit) {
            state.mode = 'WIRING';
            state.wiringFrom = { compId: pinHit.comp.id, pinId: pinHit.pinId, dir: pinHit.dir };
            state.mouseWorld = wPos;
            return;
          }

          // 2. ¿Clic en componente?
          const compHit = hitTestComponent(wPos);
          if (compHit) {
            if (compHit.type === 'SWITCH') {
              compHit.internalState.value = compHit.internalState.value === 1 ? 0 : 1;
              spawnRipple(compHit.x, compHit.y);
              soundFX.playClick(compHit.internalState.value === 1);
              evaluateCircuitDeterministic(state.components, state.wires, 0);
              saveHistorySnapshot();
            } else if (compHit.type === 'BUTTON') {
              compHit.internalState.value = 1;
              state.activePressId = compHit.id;
              spawnRipple(compHit.x, compHit.y);
              soundFX.playClick(true);
              evaluateCircuitDeterministic(state.components, state.wires, 0);
            } else if (compHit.type === 'HEX_KEY') {
              compHit.internalState.hexVal = (compHit.internalState.hexVal + (e.shiftKey ? 15 : 1)) & 0x0F;
              spawnRipple(compHit.x, compHit.y);
              soundFX.playClick(true);
              evaluateCircuitDeterministic(state.components, state.wires, 0);
              saveHistorySnapshot();
            }

            if (e.shiftKey) {
              if (state.selectedIds.has(compHit.id)) state.selectedIds.delete(compHit.id);
              else state.selectedIds.add(compHit.id);
            } else if (!state.selectedIds.has(compHit.id)) {
              state.selectedIds = new Set([compHit.id]);
            }
            state.selectedWireId = null;

            state.mode = 'DRAGGING_COMP';
            state.dragMoved = false;
            state.dragInitialPositions.clear();
            for (const id of state.selectedIds) {
              const c = state.components.find(x => x.id === id);
              if (c) state.dragInitialPositions.set(id, { x: c.x, y: c.y });
            }
            updateInspector();
            return;
          }

          // 3. ¿Clic en cable?
          const wireHit = hitTestWire(wPos, 8 / state.view.zoom);
          if (wireHit) {
            state.selectedIds.clear();
            state.selectedWireId = wireHit.id;
            updateInspector();
            return;
          }

          // 4. Fondo vacío -> Selección por recuadro (Marquee)
          if (!e.shiftKey) {
            state.selectedIds.clear();
            state.selectedWireId = null;
            updateInspector();
          }
          state.mode = 'MARQUEE';
          state.marqueeRect = { x: wPos.x, y: wPos.y, w: 0, h: 0 };
        });

        window.addEventListener('pointermove', (e) => {
          const rect = mainCanvas.getBoundingClientRect();
          const sx = e.clientX - rect.left;
          const sy = e.clientY - rect.top;
          const wPos = screenToWorld(sx, sy);

          state.mouseScreen = { x: sx, y: sy };
          state.mouseWorld = wPos;
          document.getElementById('status-coords').textContent = `X: ${Math.round(wPos.x)}, Y: ${Math.round(wPos.y)}`;

          if (state.mode === 'PANNING') {
            state.view.x += sx - state.dragStartScreen.x;
            state.view.y += sy - state.dragStartScreen.y;
            state.dragStartScreen = { x: sx, y: sy };
            return;
          }

          if (state.mode === 'DRAGGING_COMP') {
            const dx = wPos.x - state.dragStartWorld.x;
            const dy = wPos.y - state.dragStartWorld.y;
            for (const [id, initPos] of state.dragInitialPositions.entries()) {
              const c = state.components.find(x => x.id === id);
              if (c) {
                const snapV = v => (SETTINGS.snap ? Math.round(v / 10) * 10 : Math.round(v));
                const nx = snapV(initPos.x + dx);
                const ny = snapV(initPos.y + dy);
                if (nx !== c.x || ny !== c.y) state.dragMoved = true;
                c.x = nx;
                c.y = ny;
              }
            }
            return;
          }

          if (state.mode === 'MARQUEE') {
            state.marqueeRect = {
              x: Math.min(state.dragStartWorld.x, wPos.x),
              y: Math.min(state.dragStartWorld.y, wPos.y),
              w: Math.abs(wPos.x - state.dragStartWorld.x),
              h: Math.abs(wPos.y - state.dragStartWorld.y)
            };
            return;
          }

          if (state.mode === 'WIRING') {
            state.snapPin = findCompatibleSnapPin(wPos, 18 / state.view.zoom);
            return;
          }

          // Hover en reposo
          state.hoveredPin = hitTestPin(wPos, 11 / state.view.zoom);
          state.hoveredWire = state.hoveredPin ? null : hitTestWire(wPos, 8 / state.view.zoom);
          if (state.probeMode) updateProbeHUD();
        });

        window.addEventListener('pointerup', () => {
          if (state.activePressId) {
            const btnComp = state.components.find(c => c.id === state.activePressId);
            if (btnComp && btnComp.type === 'BUTTON') {
              btnComp.internalState.value = 0;
              soundFX.playClick(false);
              evaluateCircuitDeterministic(state.components, state.wires, 0);
            }
            state.activePressId = null;
          }

          if (state.mode === 'WIRING' && state.wiringFrom) {
            if (state.snapPin) {
              const outEnd = state.wiringFrom.dir === 'out'
                ? { compId: state.wiringFrom.compId, pinId: state.wiringFrom.pinId }
                : { compId: state.snapPin.comp.id, pinId: state.snapPin.pinId };
              const inEnd = state.wiringFrom.dir === 'in'
                ? { compId: state.wiringFrom.compId, pinId: state.wiringFrom.pinId }
                : { compId: state.snapPin.comp.id, pinId: state.snapPin.pinId };

              const exists = state.wires.some(w =>
                w.fromCompId === outEnd.compId && w.fromPinId === outEnd.pinId &&
                w.toCompId === inEnd.compId && w.toPinId === inEnd.pinId
              );

              if (!exists) {
                // Reemplazo limpio si la entrada ya tiene un cable (salvo tri-estado)
                const srcComp = state.components.find(c => c.id === outEnd.compId);
                const existingIn = state.wires.filter(w => w.toCompId === inEnd.compId && w.toPinId === inEnd.pinId);
                const isTri = (srcComp && srcComp.type === 'TRI_BUFFER') || existingIn.some(w => {
                  const sc = state.components.find(c => c.id === w.fromCompId);
                  return sc && sc.type === 'TRI_BUFFER';
                });
                if (existingIn.length > 0 && !isTri) {
                  state.wires = state.wires.filter(w => !(w.toCompId === inEnd.compId && w.toPinId === inEnd.pinId));
                }

                state.wires.push({
                  id: genId('w'),
                  fromCompId: outEnd.compId,
                  fromPinId: outEnd.pinId,
                  toCompId: inEnd.compId,
                  toPinId: inEnd.pinId,
                  signal: 0
                });
                spawnRipple(state.snapPin.x, state.snapPin.y, null, 28);
                soundFX.playPop(920);
                evaluateCircuitDeterministic(state.components, state.wires, 0);
                saveHistorySnapshot();
              }
            }
          } else if (state.mode === 'DRAGGING_COMP') {
            if (state.dragMoved) saveHistorySnapshot();
          } else if (state.mode === 'MARQUEE' && state.marqueeRect) {
            const r = state.marqueeRect;
            if (r.w > 4 || r.h > 4) {
              for (const c of state.components) {
                if (c.x >= r.x && c.x <= r.x + r.w && c.y >= r.y && c.y <= r.y + r.h) {
                  state.selectedIds.add(c.id);
                }
              }
              updateInspector();
            }
          }

          state.mode = 'IDLE';
          state.wiringFrom = null;
          state.snapPin = null;
          state.marqueeRect = null;
          mainCanvas.style.cursor = state.spacePressed ? 'grab' : 'default';
        });

        // Zoom con rueda del ratón hacia el cursor
        mainCanvas.addEventListener('wheel', () => { FX.lastInteract = performance.now(); }, { passive: true, capture: true });
        mainCanvas.addEventListener('wheel', (e) => {
          e.preventDefault();
          const rect = mainCanvas.getBoundingClientRect();
          const sx = e.clientX - rect.left;
          const sy = e.clientY - rect.top;
          const factor = Math.exp(-Math.max(-120, Math.min(120, e.deltaY)) * 0.0016);
          const newZoom = Math.max(0.3, Math.min(2.6, state.view.zoom * factor));
          state.view.x = sx - (sx - state.view.x) * (newZoom / state.view.zoom);
          state.view.y = sy - (sy - state.view.y) * (newZoom / state.view.zoom);
          state.view.zoom = newZoom;
          state.view.targetX = null;
          document.getElementById('zoom-readout').textContent = `${Math.round(newZoom * 100)}%`;
        }, { passive: false });

        // Doble clic y Clic derecho
        mainCanvas.addEventListener('dblclick', (e) => {
          const rect = mainCanvas.getBoundingClientRect();
          const compHit = hitTestComponent(screenToWorld(e.clientX - rect.left, e.clientY - rect.top));
          if (compHit && SETTINGS.dblclickEdit) openInlineEditor(compHit);
        });

        mainCanvas.addEventListener('contextmenu', (e) => {
          e.preventDefault();
          const rect = mainCanvas.getBoundingClientRect();
          showContextMenu(e.clientX, e.clientY, screenToWorld(e.clientX - rect.left, e.clientY - rect.top));
        });

        const inlineInp = document.getElementById('inline-edit-input');
        inlineInp.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') { e.preventDefault(); commitInlineEditor(true); }
          if (e.key === 'Escape') { e.preventDefault(); commitInlineEditor(false); }
        });
        inlineInp.addEventListener('blur', () => commitInlineEditor(true));

        // Minimapa interactivo
        minimapCanvas.addEventListener('pointerdown', (e) => {
          if (state.components.length === 0) return;
          const rect = minimapCanvas.getBoundingClientRect();
          const mx = e.clientX - rect.left;
          const my = e.clientY - rect.top;
          let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
          for (const c of state.components) {
            minX = Math.min(minX, c.x - 80); minY = Math.min(minY, c.y - 80);
            maxX = Math.max(maxX, c.x + 80); maxY = Math.max(maxY, c.y + 80);
          }
          const cw = Math.max(400, maxX - minX);
          const ch = Math.max(300, maxY - minY);
          const scale = Math.min((minimapCanvas.width - 12) / cw, (minimapCanvas.height - 12) / ch);
          const ox = (minimapCanvas.width - cw * scale) / 2 - minX * scale;
          const oy = (minimapCanvas.height - ch * scale) / 2 - minY * scale;
          const wx = (mx - ox) / scale;
          const wy = (my - oy) / scale;
          const wrapRect = canvasWrap.getBoundingClientRect();
          state.view.targetX = wrapRect.width / 2 - wx * state.view.zoom;
          state.view.targetY = wrapRect.height / 2 - wy * state.view.zoom;
          state.view.targetZoom = state.view.zoom;
        });

        // Controles de Barra Superior
        document.getElementById('preset-selector').onchange = (e) => {
          loadPresetCircuit(e.target.value);
          showToast('Circuito de ejemplo cargado');
          e.target.blur();
        };

        document.getElementById('btn-sim-toggle').onclick = () => {
          state.simRunning = !state.simRunning;
          const btn = document.getElementById('btn-sim-toggle');
          const lbl = document.getElementById('sim-toggle-label');
          const statusTxt = document.getElementById('status-sim-text');
          const statusDot = document.getElementById('status-sim-dot');
          if (state.simRunning) {
            btn.classList.add('btn-accent');
            lbl.textContent = 'Simulando';
            statusTxt.textContent = 'SIMULACIÓN ACTIVA';
            statusDot.style.background = 'var(--accent)';
          } else {
            btn.classList.remove('btn-accent');
            lbl.textContent = 'Pausado';
            statusTxt.textContent = 'SIMULACIÓN EN PAUSA';
            statusDot.style.background = 'var(--warn)';
          }
        };

        document.getElementById('btn-sim-step').onclick = () => {
          stepSimulation(0, true);
          soundFX.playClick(true);
        };

        document.getElementById('global-clock-hz').oninput = (e) => {
          state.globalClockHz = Number(e.target.value);
          document.getElementById('global-clock-label').textContent = `${state.globalClockHz.toFixed(1)}Hz`;
        };
        document.getElementById('global-clock-hz').onchange = (e) => { e.target.blur(); savePrefs(); };

        document.getElementById('btn-wire-style').onclick = () => {
          state.wireStyle = state.wireStyle === 'bezier' ? 'orthogonal' : 'bezier';
          document.getElementById('wire-style-label').textContent = state.wireStyle === 'bezier' ? 'Bézier' : 'Ortogonal';
          savePrefs();
        };

